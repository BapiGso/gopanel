{{template "header.template" .}}
<section class="page" x-data="securityPage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-inline-notification low-contrast x-show="restartRequired" x-cloak kind="warning" title="Restart required" subtitle="Stored port or login path differs from the running panel. Restart separately to apply it." hide-close-button></cds-inline-notification>
    <div class="cds--row">
        <div class="cds--col-sm-4 cds--col-md-8 cds--col-lg-10">
            <cds-tile class="stack">
                <h2>Panel configuration</h2>
                <form class="stack" @submit.prevent="save" @keydown.enter.prevent="save">
                    <div class="form-grid">
                        <cds-text-input label="Login username" required x-cds-model="username"></cds-text-input>
                        <cds-password-input label="New password" helper-text="Leave blank to keep the current password. Minimum 8 characters." autocomplete="new-password" x-cds-model="password"></cds-password-input>
                        <cds-text-input class="code-input" label="Access port" helper-text="For example :8888" required x-cds-model="port"></cds-text-input>
                        <cds-text-input class="code-input" label="Login path" helper-text="Use your configured private entry path." required x-cds-model="path"></cds-text-input>
                    </div>
                    <div class="form-actions"><cds-button :disabled="busy" type="submit" @click.prevent="save">Save changes<span slot="icon">{{icon "save" 16}}</span></cds-button></div>
                </form>
            </cds-tile>
        </div>
        <div class="cds--col-sm-4 cds--col-md-8 cds--col-lg-6 stack">
            <cds-tile class="stack"><h2>System update</h2><p class="muted">Replace the binary with the latest release. Restart separately after updating.</p><cds-button kind="tertiary" :disabled="busy" @click="update">Update GoPanel<span slot="icon">{{icon "download" 16}}</span></cds-button></cds-tile>
            <cds-tile class="stack"><h2>Restart panel</h2><p class="muted">The panel is temporarily unavailable while restarting. On unsupported platforms, restart it manually.</p><cds-button kind="danger--tertiary" :disabled="busy" @click="restart">Restart panel<span slot="icon">{{icon "renew" 16}}</span></cds-button></cds-tile>
        </div>
    </div>
    <cds-inline-loading x-show="busy" x-cloak assistive-text="Applying changes">Applying changes</cds-inline-loading>
</section>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tile.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/text-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/password-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/inline-loading.min.js"></script>
<script defer src="/assets/js/pages/security.js"></script>
{{template "footer.template" .}}
