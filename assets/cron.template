{{template "header.template"}}

<div class="text-base-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h3 class="text-2xl font-bold tracking-tight flex items-center">
            <i class="ri-time-line text-primary mr-3"></i>Cron Scheduler
        </h3>
        <p class="text-sm opacity-60 mt-1 ml-9">Manage scheduled tasks and automation</p>
    </div>

    <div role="alert" class="alert alert-warning mb-8">
        <i class="ri-flask-line text-xl"></i>
        <div>
            <h4 class="font-bold">Experimental Feature</h4>
            <p class="text-sm opacity-90">Scheduled tasks are currently stored in memory. <span class="font-semibold">They will be lost if the panel restarts.</span></p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1">
            <div class="card surface p-6 sticky top-6">
                <div class="flex items-center gap-2 mb-6">
                    <i class="ri-add-circle-line text-primary text-lg"></i>
                    <h4 class="text-base font-semibold">New Task</h4>
                </div>

                <form action="/admin/cron" @submit.prevent="createCron" class="space-y-5">
                    <div>
                        <span class="eyebrow block mb-1.5">Job Name</span>
                        <input name="name" type="text" placeholder="e.g., daily-backup" required
                               class="input input-bordered input-sm w-full">
                    </div>

                    <div>
                        <span class="eyebrow block mb-1.5">Template</span>
                        <select required x-model="script" class="select select-bordered select-sm w-full">
                            <option selected disabled value="">Select a template...</option>
                            <option value="">Custom Shell Script</option>
                            <option value="tar -czvf name.tar.gz /home/user/mydir">Backup Directory (Tar)</option>
                            <option value="curl -L https://www.example.com">Ping URL (Curl)</option>
                        </select>
                    </div>

                    <div>
                        <span class="eyebrow block mb-1.5">Frequency Base</span>
                        <select name="frequency" required x-model="freMax" class="select select-bordered select-sm w-full">
                            <option selected disabled value="">Select frequency...</option>
                            <option value="43199">Monthly</option>
                            <option value="10079">Weekly</option>
                            <option value="1439">Daily</option>
                            <option value="43200">Every N minutes</option>
                        </select>
                    </div>

                    <div>
                        <div class="row mb-2">
                            <span class="eyebrow">Execution Time</span>
                            <span class="text-primary font-mono text-xs" x-text="formatTimestamp(sliderValue)"></span>
                        </div>
                        <input x-ref="timeSlider" :max="freMax" min="1" name="attime" x-model="sliderValue" type="range"
                               class="range range-primary range-sm">
                    </div>

                    <div>
                        <span class="eyebrow block mb-1.5">Script Content</span>
                        <textarea name="script" rows="5" x-model="script" required placeholder="#!/bin/bash..."
                                  class="textarea textarea-bordered w-full font-mono text-xs"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="ri-add-line"></i>Create Cron Job
                    </button>
                </form>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="card surface overflow-hidden">
                <div class="px-6 py-4 border-b border-base-300">
                    <h4 class="text-base font-semibold flex items-center"><i class="ri-list-check opacity-50 mr-2"></i>Scheduled Jobs</h4>
                </div>

                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                        <tr>
                            <th>Name</th><th>Status</th><th>Last Run</th><th>Next Run</th><th class="text-right">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{range $k,$v:= .}}
                            <tr class="hover">
                                <td class="font-medium">{{$v.Name}}</td>
                                <td>
                                    <span class="badge badge-sm badge-outline" :class="{{$v.Paused}} ? 'badge-warning' : 'badge-success'"
                                          x-text="{{$v.Paused}} ? 'Paused' : 'Active'"></span>
                                </td>
                                <td class="font-mono text-xs opacity-70">{{$v.LastRun}}</td>
                                <td class="font-mono text-xs opacity-70">{{$v.NextRun}}</td>
                                <td class="text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <button @click="Action('runnow', `{{$v.Name}}`)" class="btn btn-ghost btn-xs text-info" title="Run Now">
                                            <i class="ri-play-circle-line text-lg"></i>
                                        </button>
                                        <button x-show="{{$v.Paused}}" @click="Action('unpause', `{{$v.Name}}`)" class="btn btn-ghost btn-xs text-success" title="Resume">
                                            <i class="ri-play-line text-lg"></i>
                                        </button>
                                        <button x-show="{{not $v.Paused}}" @click="Action('pause', `{{$v.Name}}`)" class="btn btn-ghost btn-xs text-warning" title="Pause">
                                            <i class="ri-pause-line text-lg"></i>
                                        </button>
                                        <button @click="confirm('Are you sure you want to delete this job?') && Action('remove',`{{$v.Name}}`)" class="btn btn-ghost btn-xs text-error" title="Delete">
                                            <i class="ri-delete-bin-line text-lg"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                        </tbody>
                    </table>

                    {{if not .}}
                        <div class="px-6 py-12 text-center">
                            <div class="w-12 h-12 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="ri-calendar-check-line text-2xl opacity-40"></i>
                            </div>
                            <p class="text-sm opacity-60">No scheduled tasks defined</p>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('panel', () => ({
            freMax: 43200,
            script: "",
            sliderValue: 30000,

            formatTimestamp(timestamp) {
                let totalSeconds = Math.floor(timestamp * 60);
                let days = Math.floor(totalSeconds / (24 * 3600));
                totalSeconds %= (24 * 3600);
                let hours = Math.floor(totalSeconds / 3600);
                totalSeconds %= 3600;
                let minutes = Math.floor(totalSeconds / 60);
                return `${days}D ${hours}H ${minutes}M`;
            },
            async createCron(event) {
                try {
                    const fields = new FormData(event.target);
                    const frequency = Number(fields.get('frequency'));
                    const minutes = Number(fields.get('attime'));
                    const hour = Math.floor(minutes / 60) % 24;
                    const minute = minutes % 60;
                    const day = Math.floor(minutes / 1440);
                    const body = {name: fields.get('name'), script: fields.get('script')};
                    if (frequency === 43200) {
                        body.interval_seconds = minutes * 60;
                    } else {
                        body.schedule = frequency === 43199 ? `${minute} ${hour} ${Math.max(1, day)} * *`
                            : frequency === 10079 ? `${minute} ${hour} * * ${day % 7}`
                            : `${minute} ${hour} * * *`;
                    }
                    await panelAPI('/cron/jobs', {method: 'POST', body});
                    alert('Cron job created successfully');
                    location.reload();
                } catch (error) {
                    alert('Failed to create cron job: ' + error.message);
                }
            },

            async Action(action, name) {
                try {
                    const path = `/cron/jobs/${encodeURIComponent(name)}`;
                    if (action === 'remove') await panelAPI(path, {method: 'DELETE'});
                    else if (action === 'runnow') await panelAPI(`${path}/run`, {method: 'POST'});
                    else await panelAPI(path, {method: 'PATCH', body: {paused: action === 'pause'}});
                    alert(`${action} successful`);
                    location.reload();
                } catch (error) {
                    alert('Action failed: ' + error.message);
                }
            }
        }))
    })
</script>
{{template "footer.template"}}
