{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/data-table.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/overflow-menu.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/text-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/textarea.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/select.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/number-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/search.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script defer src="/assets/js/pages/cron.js"></script>
<section class="page" x-data="cronPage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-inline-notification low-contrast kind="warning" title="Experimental feature" subtitle="Schedules are stored in memory and are lost when the panel restarts." hide-close-button></cds-inline-notification>
    <section aria-label="Jobs">
    <cds-table-toolbar size="lg"><cds-table-toolbar-content><cds-table-toolbar-search persistent label-text="Search jobs" placeholder="Search jobs" x-cds-model="search"></cds-table-toolbar-search><cds-button kind="ghost" :disabled="busy" @click="read()">Refresh<span slot="icon">{{icon "renew" 16}}</span></cds-button><cds-button :disabled="busy" @click="openJob()">Create job<span slot="icon">{{icon "add" 16}}</span></cds-button></cds-table-toolbar-content></cds-table-toolbar>
    <div class="table-scroll" role="region" aria-label="Scheduled jobs" tabindex="0"><cds-table>
        <cds-table-head><cds-table-header-row><cds-table-header-cell>Name</cds-table-header-cell><cds-table-header-cell>Status</cds-table-header-cell><cds-table-header-cell>Schedule</cds-table-header-cell><cds-table-header-cell>Last run</cds-table-header-cell><cds-table-header-cell>Next run</cds-table-header-cell><cds-table-header-cell>Actions</cds-table-header-cell></cds-table-header-row></cds-table-head>
        <cds-table-body><template x-for="job in filteredJobs" :key="job.name"><cds-table-row>
            <cds-table-cell x-text="job.name"></cds-table-cell><cds-table-cell><cds-tag :type="job.paused ? 'warm-gray' : 'green'" x-text="job.paused ? 'Paused' : 'Active'"></cds-tag></cds-table-cell>
            <cds-table-cell><span class="mono" x-show="job.schedule" x-text="job.schedule"></span><span x-show="!job.schedule" x-text="'Every ' + job.interval_seconds + ' seconds'"></span></cds-table-cell><cds-table-cell x-text="job.last_run ? $store.helpers.date(job.last_run) : 'Never'"></cds-table-cell><cds-table-cell x-text="job.paused ? '—' : job.next_run ? $store.helpers.date(job.next_run) : '—'"></cds-table-cell>
            <cds-table-cell><cds-overflow-menu :label="'Actions for ' + job.name"><span slot="icon">{{icon "overflow-menu--vertical" 16}}</span><cds-overflow-menu-body flipped>
                <cds-overflow-menu-item :disabled="busy || job.paused" @click="act('run', job)">Run now</cds-overflow-menu-item>
                <cds-overflow-menu-item :disabled="busy" @click="openJob(job)">Edit</cds-overflow-menu-item>
                <cds-overflow-menu-item :disabled="busy" @click="act('pause', job)" x-text="job.paused ? 'Resume' : 'Pause'"></cds-overflow-menu-item>
                <cds-overflow-menu-item danger :disabled="busy" @click="act('delete', job)">Delete</cds-overflow-menu-item>
            </cds-overflow-menu-body></cds-overflow-menu></cds-table-cell>
        </cds-table-row></template></cds-table-body>
    </cds-table></div>
    <p class="table-empty" x-show="!filteredJobs.length">No matching scheduled jobs.</p>
    </section>
    <cds-modal size="lg" x-cds-prop:open="jobOpen" @cds-modal-closed="jobOpen = false">
        <cds-modal-header><cds-modal-close-button></cds-modal-close-button><cds-modal-heading x-text="editing ? 'Edit job' : 'Create job'"></cds-modal-heading></cds-modal-header>
        <cds-modal-body><div class="stack">
            <div class="form-grid">
                <cds-text-input label="Job name" helper-text="Letters, numbers, dots, underscores or hyphens; up to 64 characters" :disabled="editing" x-cds-model="form.name"></cds-text-input>
                <cds-select label-text="Frequency" x-cds-model="frequency"><cds-select-item value="custom">Custom cron expression</cds-select-item><cds-select-item value="daily">Daily</cds-select-item><cds-select-item value="weekly">Weekly</cds-select-item><cds-select-item value="monthly">Monthly</cds-select-item><cds-select-item value="interval">Fixed interval</cds-select-item></cds-select>
                <cds-text-input x-show="frequency === 'custom'" label="Cron expression" helper-text="Five fields: minute hour day month weekday" x-cds-model="form.schedule"></cds-text-input>
                <cds-number-input x-show="frequency === 'interval'" label="Interval in seconds" min="1" max="31536000" step="1" x-cds-model.number="form.interval_seconds"></cds-number-input>
                <cds-text-input x-show="['daily', 'weekly', 'monthly'].includes(frequency)" label="Execution time" helper-text="24-hour time, HH:MM" x-cds-model="time"></cds-text-input>
                <cds-number-input x-show="frequency === 'monthly'" label="Day of month" min="1" max="31" step="1" x-cds-model.number="day"></cds-number-input>
                <cds-select x-show="frequency === 'weekly'" label-text="Weekday" x-cds-model="weekday"><cds-select-item value="0">Sunday</cds-select-item><cds-select-item value="1">Monday</cds-select-item><cds-select-item value="2">Tuesday</cds-select-item><cds-select-item value="3">Wednesday</cds-select-item><cds-select-item value="4">Thursday</cds-select-item><cds-select-item value="5">Friday</cds-select-item><cds-select-item value="6">Saturday</cds-select-item></cds-select>
                <cds-select label-text="Script template" x-cds-model="scriptTemplate" @cds-select-selected="applyTemplate($event.target.value)"><cds-select-item value="custom">Custom shell script</cds-select-item><cds-select-item value="backup">Backup directory (Tar)</cds-select-item><cds-select-item value="curl">Ping URL (Curl)</cds-select-item></cds-select>
            </div>
            <cds-textarea label="Script content" rows="10" x-cds-model="form.script"></cds-textarea>
        </div></cds-modal-body>
        <cds-modal-footer><cds-modal-footer-button kind="secondary" @click="jobOpen = false">Cancel</cds-modal-footer-button><cds-modal-footer-button :disabled="busy" @click="save()">Save job</cds-modal-footer-button></cds-modal-footer>
    </cds-modal>
</section>
{{template "footer.template" .}}
