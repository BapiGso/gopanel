{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/tabs.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/toggle.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/link.min.js"></script>
<script defer src="/assets/js/ace.js"></script>
<script defer src="/assets/js/mode-toml.js"></script>
<script defer src="/assets/js/pages/frp.js"></script>
<section class="page" x-data="frpPage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-tabs x-cds-prop:value="currentTab" @cds-tabs-selected="switchTab($event.detail.item.value)">
        <cds-tab id="frps-tab" value="frps" target="frps-panel">Server (frps)</cds-tab>
        <cds-tab id="frpc-tab" value="frpc" target="frpc-panel">Client (frpc)</cds-tab>
    </cds-tabs>
    <div class="toolbar">
        <cds-button size="md" kind="ghost" :disabled="busy" @click="manage('start')">Start</cds-button>
        <cds-button size="md" kind="ghost" :disabled="busy" @click="manage('reload')">Reload</cds-button>
        <cds-button size="md" kind="ghost" :disabled="busy" @click="manage('stop')">Stop</cds-button>
        <cds-toggle hidelabel label-text="Autostart" label-a="Autostart on" label-b="Autostart off" :disabled="busy" x-cds-prop:toggled="currentStatus.autostart" @cds-toggle-changed="autostart($event.target.toggled)"></cds-toggle>
        <span x-show="currentStatus.pending_changes" class="cds--type-label-01 muted">Saved changes not applied</span>
    </div>
    <cds-inline-notification low-contrast x-show="currentStatus.last_error" x-cloak kind="error" title="Service error" :subtitle="currentStatus.last_error" hide-close-button></cds-inline-notification>
    <p class="muted" x-text="currentTab === 'frps' ? 'The server accepts incoming connections on its public address.' : 'The client connects to a remote server to expose local ports.'"></p>
    <div class="editor-frame">
        <div class="toolbar">
            <h2 class="editor-title cds--type-code-02" x-text="currentTab + '.toml'"></h2>
            <cds-button size="md" kind="ghost" :disabled="busy" @click="reloadDocument()">Read saved file</cds-button>
            <cds-button size="md" :disabled="busy" @click="save()">Save configuration<span slot="icon">{{icon "save" 16}}</span></cds-button>
        </div>
        <section id="frps-panel" role="tabpanel" aria-labelledby="frps-tab" x-show="currentTab === 'frps'"><div class="editor" x-ref="frpsEditor" aria-label="FRPS TOML editor"></div></section>
        <section id="frpc-panel" role="tabpanel" aria-labelledby="frpc-tab" x-show="currentTab === 'frpc'" x-cloak><div class="editor" x-ref="frpcEditor" aria-label="FRPC TOML editor"></div></section>
    </div>
    <p class="muted">Saving validates the configuration without applying it. Reload replaces the embedded service. Status reflects its service loop, not remote connectivity readiness.</p>
</section>
{{template "footer.template" .}}
