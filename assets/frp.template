{{template "header.template"}}

<div class="text-base-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" x-data="frpPanel">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h3 class="text-2xl font-bold tracking-tight flex items-center">
                <i class="ri-arrow-left-right-line text-primary mr-3"></i>FRP Manager
            </h3>
            <p class="text-sm opacity-60 mt-1 ml-9">Manage Fast Reverse Proxy Server & Client</p>
        </div>

        <div role="tablist" class="tabs tabs-boxed">
            <a role="tab" class="tab gap-2" :class="currentTab === 'frps' && 'tab-active'" @click="switchTab('frps')">
                <i class="ri-server-line"></i>Server
            </a>
            <a role="tab" class="tab gap-2" :class="currentTab === 'frpc' && 'tab-active'" @click="switchTab('frpc')">
                <i class="ri-links-line"></i>Client
            </a>
        </div>
    </div>

    <div class="surface rounded-2xl px-6 py-4 mb-6 flex flex-wrap items-center justify-between gap-4">
        <button @click="manageService('start')" class="btn btn-primary group">
            <i class="ri-play-circle-line text-lg group-hover:scale-110 transition-transform"></i>
            <span x-text="'Start ' + (currentTab === 'frps' ? 'Server' : 'Client')"></span>
        </button>

        <label class="flex items-center gap-3 cursor-pointer">
            <div class="flex flex-col items-end">
                <span class="eyebrow">Boot on Start</span>
                <span class="text-[11px] font-bold" :class="isEnabled ? 'text-success' : 'opacity-50'"
                      x-text="isEnabled ? 'ENABLED' : 'DISABLED'"></span>
            </div>
            <input type="checkbox" class="toggle toggle-success" :checked="isEnabled" @change="manageService('enable')">
        </label>
    </div>

    <div class="rounded-2xl p-5 mb-6 bg-info/10 border border-info/20">
        <div class="flex items-start gap-3">
            <i class="ri-information-fill text-info text-xl mt-0.5"></i>
            <div>
                <h5 class="text-sm font-bold mb-1" x-text="'About ' + (currentTab === 'frps' ? 'FRPS' : 'FRPC')"></h5>
                <div class="text-sm opacity-80">
                    <span x-show="currentTab === 'frps'">This acts as the <strong>Server</strong>. Public IPs connect here.</span>
                    <span x-show="currentTab === 'frpc'">This acts as the <strong>Client</strong>. It connects to a remote server to expose local ports.</span>
                    <span class="block mt-1 opacity-70 text-xs">Note: Services cannot be stopped directly via UI once started, restart panel if needed.</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card surface overflow-hidden flex flex-col h-[calc(100vh-400px)] min-h-[500px]">
        <div class="row px-6 py-3 border-b border-base-300 bg-base-200/40">
            <div class="flex items-center gap-2">
                <i class="ri-file-settings-line opacity-50"></i>
                <span class="text-sm font-semibold font-mono" x-text="currentTab + '.toml'"></span>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <a :href="'https://github.com/fatedier/frp/blob/dev/conf/' + currentTab + '_full_example.toml'" target="_blank"
                   class="link link-hover text-primary font-medium flex items-center">
                    <i class="ri-book-read-line mr-1"></i>Example
                </a>
                <button @click="saveConfig" class="btn btn-primary btn-sm">
                    <i class="ri-save-3-line"></i>Save Config
                </button>
            </div>
        </div>

        <div class="relative flex-1 w-full bg-[#272822]">
            <div id="editor-frps" class="absolute inset-0 w-full h-full text-base" x-show="currentTab === 'frps'"></div>
            <div id="editor-frpc" class="absolute inset-0 w-full h-full text-base" x-show="currentTab === 'frpc'"></div>
        </div>
    </div>

</div>

<script type="text/javascript" src="/assets/js/ace.js"></script>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('frpPanel', () => ({
            currentTab: 'frps', // 'frps' or 'frpc'
            // Config content and status from Go template
            configs: {
                frps: `{{.frpsConfig}}`,
                frpc: `{{.frpcConfig}}`
            },
            status: {
                frps: {{.frpsEnable}},
                frpc: {{.frpcEnable}}
            },
            editors: {},

            init() {
                // Initialize both editors
                this.initEditor('frps', this.configs.frps);
                this.initEditor('frpc', this.configs.frpc);

                // Add save shortcut
                document.addEventListener('keydown', (e) => {
                    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                        e.preventDefault();
                        this.saveConfig();
                    }
                });
            },

            initEditor(type, content) {
                const el = document.getElementById('editor-' + type);
                const editor = ace.edit(el);
                editor.setTheme("ace/theme/monokai");
                editor.session.setMode("ace/mode/toml");
                editor.setOptions({
                    fontSize: "14px",
                    showPrintMargin: false,
                    showGutter: true,
                    highlightActiveLine: true,
                    wrap: true,
                    fontFamily: "'JetBrains Mono', 'Fira Code', monospace"
                });
                editor.setValue(content, -1);
                this.editors[type] = editor;
            },

            get isEnabled() {
                return this.status[this.currentTab];
            },

            switchTab(tab) {
                this.currentTab = tab;
                // Fix ACE editor rendering issue when switching tabs (hidden divs have size 0)
                this.$nextTick(() => {
                    this.editors[tab].resize();
                    this.editors[tab].renderer.updateFull();
                });
            },

            async saveConfig() {
                const content = this.editors[this.currentTab].getValue();
                try {
                    // PUT /admin/frp?type=frps (or frpc)
                    const response = await fetch(`/admin/frp?type=${this.currentTab}`, {
                        method: 'PUT',
                        body: content,
                    });
                    const result = await response.text();
                    alert(result);
                    // Update local state if needed, or reload
                    // location.reload();
                } catch (error) {
                    alert('Failed to save: ' + error.message);
                }
            },

            async manageService(action) {
                // action: 'enable' or 'start'
                const type = this.currentTab;

                // Optimistic UI update for toggle
                if (action === 'enable') {
                    this.status[type] = !this.status[type];
                }

                try {
                    // POST /admin/frp?type=frps&status=enable
                    const response = await fetch(`/admin/frp?type=${type}&status=${action}`, {
                        method: "POST"
                    });
                    const result = await response.text();
                    alert(result);
                    if (action !== 'enable') location.reload();
                } catch (error) {
                    // Revert UI on error
                    if (action === 'enable') this.status[type] = !this.status[type];
                    alert('Operation failed: ' + error.message);
                }
            }
        }))
    })
</script>

{{template "footer.template"}}
