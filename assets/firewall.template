{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/data-table.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/overflow-menu.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/select.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/number-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/search.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script defer src="/assets/js/pages/firewall.js"></script>
<section class="page" x-data="firewallPage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-inline-notification low-contrast kind="warning" title="Advanced feature" subtitle="Firewall changes can interrupt panel and network connectivity. Ensure you understand each rule before applying it." hide-close-button></cds-inline-notification>
    <section aria-label="Rules">
    <cds-table-toolbar size="lg"><cds-table-toolbar-content><cds-table-toolbar-search persistent label-text="Search firewall rules" placeholder="Search rules" x-cds-model="search"></cds-table-toolbar-search><cds-button kind="ghost" :disabled="busy" @click="read()">Refresh<span slot="icon">{{icon "renew" 16}}</span></cds-button><cds-button :disabled="busy" @click="openCreate()">Add rule<span slot="icon">{{icon "add" 16}}</span></cds-button></cds-table-toolbar-content></cds-table-toolbar>
    <div class="table-scroll" role="region" aria-label="Firewall rules" tabindex="0">
        <cds-table><cds-table-head><cds-table-header-row><cds-table-header-cell>Port</cds-table-header-cell><cds-table-header-cell>Action</cds-table-header-cell><cds-table-header-cell>Network</cds-table-header-cell><cds-table-header-cell>Protocol</cds-table-header-cell><cds-table-header-cell>Direction</cds-table-header-cell><cds-table-header-cell>Actions</cds-table-header-cell></cds-table-header-row></cds-table-head>
            <cds-table-body><template x-for="rule in filteredRules" :key="rule.id"><cds-table-row>
                <cds-table-cell class="mono" x-text="rule.port || 'All'"></cds-table-cell>
                <cds-table-cell><cds-tag :type="rule.action === 'accept' ? 'green' : 'red'" x-text="rule.action"></cds-tag></cds-table-cell>
                <cds-table-cell x-text="rule.network"></cds-table-cell><cds-table-cell x-text="rule.protocol.toUpperCase()"></cds-table-cell><cds-table-cell x-text="rule.direction === 'in' ? 'In' : 'Out'"></cds-table-cell>
                <cds-table-cell><cds-overflow-menu :label="'Actions for rule ' + rule.id"><span slot="icon">{{icon "overflow-menu--vertical" 16}}</span><cds-overflow-menu-body flipped><cds-overflow-menu-item danger :disabled="busy" @click="remove(rule)">Delete</cds-overflow-menu-item></cds-overflow-menu-body></cds-overflow-menu></cds-table-cell>
            </cds-table-row></template></cds-table-body>
        </cds-table>
    </div>
    <p class="table-empty" x-show="!filteredRules.length">No matching firewall rules.</p>
    </section>
    <cds-modal x-cds-prop:open="createOpen" @cds-modal-closed="createOpen = false">
        <cds-modal-header><cds-modal-close-button></cds-modal-close-button><cds-modal-heading>Add firewall rule</cds-modal-heading></cds-modal-header>
        <cds-modal-body><div class="form-grid">
            <cds-number-input label="Port" helper-text="0 means any port" min="0" max="65535" step="1" x-cds-model.number="form.port"></cds-number-input>
            <cds-select label-text="Action" x-cds-model="form.action"><cds-select-item value="accept">Accept</cds-select-item><cds-select-item value="drop">Drop</cds-select-item></cds-select>
            <cds-select label-text="Network" x-cds-model="form.network"><cds-select-item value="ipv4">IPv4</cds-select-item><cds-select-item value="ipv6">IPv6</cds-select-item></cds-select>
            <cds-select label-text="Protocol" x-cds-model="form.protocol"><cds-select-item value="tcp">TCP</cds-select-item><cds-select-item value="udp">UDP</cds-select-item></cds-select>
            <cds-select label-text="Direction" x-cds-model="form.direction"><cds-select-item value="in">In</cds-select-item><cds-select-item value="out">Out</cds-select-item></cds-select>
        </div></cds-modal-body>
        <cds-modal-footer><cds-modal-footer-button kind="secondary" @click="createOpen = false">Cancel</cds-modal-footer-button><cds-modal-footer-button :disabled="busy" @click="create()">Add rule</cds-modal-footer-button></cds-modal-footer>
    </cds-modal>
</section>
{{template "footer.template" .}}
