{{template "header.template"}}

<div class="text-base-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h3 class="text-2xl font-bold tracking-tight flex items-center">
            <i class="ri-shield-keyhole-line text-primary mr-3"></i>Firewall
        </h3>
        <p class="text-sm opacity-60 mt-1 ml-9">Manage firewall rules</p>
    </div>

    <div role="alert" class="alert alert-warning mb-6">
        <i class="ri-error-warning-line text-xl"></i>
        <div>
            <h4 class="font-bold">Advanced Feature</h4>
            <p class="text-sm opacity-90">Directly manipulating firewall rules can affect network connectivity. Ensure you understand the rule implications.</p>
        </div>
    </div>

    <div class="card surface !p-6 mb-8">
        <div class="flex items-center gap-2 mb-4">
            <i class="ri-add-box-line text-primary"></i>
            <h4 class="text-sm font-semibold">Add New Rule</h4>
        </div>

        <form action="" @submit.prevent="createRule">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 items-end">
                <div>
                    <span class="eyebrow block mb-1.5">Network</span>
                    <select name="network" required class="select select-bordered select-sm w-full">
                        <option selected disabled value="">Select...</option>
                        <option value="ipv4">IPv4</option>
                        <option value="ipv6">IPv6</option>
                    </select>
                </div>
                <div>
                    <span class="eyebrow block mb-1.5">Protocol</span>
                    <select name="protocol" required class="select select-bordered select-sm w-full">
                        <option selected disabled value="">Select...</option>
                        <option value="tcp">TCP</option>
                        <option value="udp">UDP</option>
                    </select>
                </div>
                <div>
                    <span class="eyebrow block mb-1.5">Direction</span>
                    <select name="direction" required class="select select-bordered select-sm w-full">
                        <option selected disabled value="">Select...</option>
                        <option value="in">In</option>
                        <option value="out">Out</option>
                    </select>
                </div>
                <div>
                    <span class="eyebrow block mb-1.5">Port</span>
                    <input name="port" type="number" required placeholder="e.g. 80" class="input input-bordered input-sm w-full">
                </div>
                <div>
                    <span class="eyebrow block mb-1.5">Action</span>
                    <select name="action" required class="select select-bordered select-sm w-full">
                        <option selected disabled value="">Select...</option>
                        <option value="accept">Accept</option>
                        <option value="drop">Drop</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm"><i class="ri-add-line"></i>Add Rule</button>
            </div>
        </form>
    </div>

    <div class="card surface overflow-hidden">
        <div class="px-6 py-4 border-b border-base-300">
            <h4 class="text-base font-semibold flex items-center"><i class="ri-list-settings-line opacity-50 mr-2"></i>Active Rules</h4>
        </div>

        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                <tr>
                    <th>Network</th><th>Protocol</th><th>Port</th><th>Direction</th><th>Action</th><th class="text-right">Actions</th>
                </tr>
                </thead>
                <tbody>
                {{range .}}
                    <tr class="hover">
                        <td><span class="badge badge-ghost badge-sm font-mono uppercase">{{.Network}}</span></td>
                        <td class="uppercase opacity-70">{{.Protocol}}</td>
                        <td>
                            {{if .Port}}<span class="font-mono font-bold">{{.Port}}</span>
                            {{else}}<span class="opacity-40 text-xs">ALL</span>{{end}}
                        </td>
                        <td>
                            <span class="badge badge-sm {{if eq .Direction "in"}}badge-info{{else}}badge-primary{{end}}">
                                {{if eq .Direction "in"}}In{{else}}Out{{end}}
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-sm {{if eq .Action "accept"}}badge-success{{else}}badge-error{{end}}">
                                {{if eq .Action "accept"}}Accept{{else}}Drop{{end}}
                            </span>
                        </td>
                        <td class="text-right">
                            <button @click="deleteRule(`{{.ID}}`)" class="btn btn-ghost btn-xs text-error" title="Delete Rule">
                                <i class="ri-delete-bin-line text-lg"></i>
                            </button>
                        </td>
                    </tr>
                {{end}}
                </tbody>
            </table>

            {{if not .}}
                <div class="px-6 py-12 text-center">
                    <div class="w-12 h-12 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="ri-shield-check-line text-2xl opacity-40"></i>
                    </div>
                    <p class="text-sm opacity-60">No firewall rules configured</p>
                </div>
            {{end}}
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('panel', () => ({
            async createRule(e) {
                try {
                    const response = await fetch(location.pathname, {
                        method: "POST",
                        body: new FormData(e.target)
                    });
                    alert(await response.text());
                    location.reload();
                } catch (error) {
                    alert('Failed to create rule: ' + error.message);
                }
            },
            async deleteRule(id) {
                if (confirm("Are you sure you want to delete this rule?")) {
                    try {
                        const response = await fetch(`/admin/firewall?id=${encodeURIComponent(id)}`, {
                            method: "DELETE"
                        });
                        const result = await response.json();
                        if (result.error) {
                            alert('Error: ' + result.error);
                        } else {
                            alert('Rule deleted successfully');
                        }
                        location.reload();
                    } catch (error) {
                        alert('Failed to delete rule: ' + error.message);
                    }
                }
            }
        }))
    })
</script>
{{template "footer.template"}}
