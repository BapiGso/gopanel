{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/breadcrumb.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/data-table.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/overflow-menu.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/text-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/select.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/search.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/file-uploader.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/link.min.js"></script>
<script defer src="/assets/js/ace.js"></script>
<script defer src="/assets/js/mode-toml.js"></script>
<script defer src="/assets/js/mode-caddyfile.js"></script>
<script defer src="/assets/js/pages/file.js"></script>
<section class="page" x-data="filePage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <div class="breadcrumbs">
        <cds-breadcrumb no-trailing-slash>
            <cds-breadcrumb-item><cds-breadcrumb-link href="#" @click.prevent="navigate('/')">Root</cds-breadcrumb-link></cds-breadcrumb-item>
            <cds-breadcrumb-item class="breadcrumb-overflow" x-show="crumbs.length > 1"><cds-overflow-menu label="Parent folders" breadcrumb><span slot="icon">{{icon "overflow-menu--vertical" 16}}</span><cds-overflow-menu-body><template x-for="crumb in crumbs.slice(0, -1)" :key="crumb.path"><cds-overflow-menu-item @click="navigate(crumb.path)" x-text="crumb.name"></cds-overflow-menu-item></template></cds-overflow-menu-body></cds-overflow-menu></cds-breadcrumb-item>
            <template x-for="(crumb, index) in crumbs" :key="crumb.path"><cds-breadcrumb-item :class="index < crumbs.length - 1 ? 'breadcrumb-middle' : ''"><cds-breadcrumb-link href="#" @click.prevent="navigate(crumb.path)" x-text="crumb.name" :title="crumb.name"></cds-breadcrumb-link></cds-breadcrumb-item></template>
        </cds-breadcrumb>
    </div>
    <section aria-label="Files">
    <cds-table-toolbar size="lg"><cds-table-toolbar-content>
        <cds-text-input class="table-toolbar-path code-input" hide-label label="Directory path" aria-label="Directory path" x-cds-model="pathInput" @keydown.enter.prevent="navigate(pathInput)"></cds-text-input>
        <cds-button kind="ghost" :disabled="busy" @click="navigate(pathInput)">Go</cds-button>
        <cds-button kind="ghost" :disabled="busy || directory === '/'" @click="up()">Up<span slot="icon">{{icon "arrow--left" 16}}</span></cds-button>
        <cds-button kind="ghost" :disabled="busy" @click="navigate(directory)">Refresh<span slot="icon">{{icon "renew" 16}}</span></cds-button>
        <cds-table-toolbar-search persistent label-text="Filter this directory" placeholder="Filter files" x-cds-model="search"></cds-table-toolbar-search>
        <cds-button :disabled="busy" @click="openCreate()">New<span slot="icon">{{icon "add" 16}}</span></cds-button>
    </cds-table-toolbar-content></cds-table-toolbar>
    <p class="table-meta cds--type-label-01 muted" x-text="files.length + ' entries'"></p>
    <div class="table-scroll" role="region" aria-label="Directory listing" tabindex="0"><cds-table>
        <cds-table-head><cds-table-header-row><cds-table-header-cell>Name</cds-table-header-cell><cds-table-header-cell>Size</cds-table-header-cell><cds-table-header-cell>Mode</cds-table-header-cell><cds-table-header-cell>Modified</cds-table-header-cell><cds-table-header-cell>Actions</cds-table-header-cell></cds-table-header-row></cds-table-head>
        <cds-table-body><template x-for="entry in filteredFiles" :key="entry.path"><cds-table-row>
            <cds-table-cell><div class="file-name"><span x-show="entry.type === 'directory'">{{icon "folder" 16}}</span><span x-show="entry.type !== 'directory'">{{icon "document" 16}}</span><cds-link :href="entry.type === 'directory' ? '#' : downloadPath(entry.path)" @click="entry.type === 'directory' &amp;&amp; ($event.preventDefault(), navigate(entry.path))" x-text="entry.name"></cds-link></div></cds-table-cell>
            <cds-table-cell x-text="entry.type === 'directory' ? '—' : $store.helpers.bytes(entry.size)"></cds-table-cell><cds-table-cell class="mono" x-text="entry.permissions"></cds-table-cell><cds-table-cell x-text="$store.helpers.date(entry.modified_at)"></cds-table-cell>
            <cds-table-cell><cds-overflow-menu :label="'Actions for ' + entry.name"><span slot="icon">{{icon "overflow-menu--vertical" 16}}</span><cds-overflow-menu-body flipped>
                <cds-overflow-menu-item x-show="entry.type === 'directory'" :disabled="busy" @click="navigate(entry.path)">Open folder</cds-overflow-menu-item>
                <cds-overflow-menu-item x-show="entry.type !== 'directory'" :disabled="busy" @click="openEditor(entry)">Edit</cds-overflow-menu-item>
                <cds-overflow-menu-item x-show="entry.type !== 'directory'" :href="downloadPath(entry.path)">Download</cds-overflow-menu-item>
                <cds-overflow-menu-item :disabled="busy" @click="openChange('rename', entry)">Rename</cds-overflow-menu-item>
                <cds-overflow-menu-item :disabled="busy" @click="openChange('permissions', entry)">Permissions</cds-overflow-menu-item>
                <cds-overflow-menu-item danger :disabled="busy" @click="remove(entry)">Delete</cds-overflow-menu-item>
            </cds-overflow-menu-body></cds-overflow-menu></cds-table-cell>
        </cds-table-row></template></cds-table-body>
    </cds-table></div>
    <p class="table-empty" x-show="!filteredFiles.length">No matching files or folders.</p>
    </section>
    <section class="upload-section stack" aria-label="Upload files">
        <h2 class="cds--type-heading-compact-02">Upload files</h2>
        <cds-file-uploader label-description="Up to 32 MiB per upload. Same-name files are replaced.">
            <cds-file-uploader-drop-container multiple :disabled="busy" @cds-file-uploader-drop-container-changed="upload($event.detail.addedFiles)">Drag files here or click to upload</cds-file-uploader-drop-container>
        </cds-file-uploader>
    </section>
    <cds-modal x-cds-prop:open="changeOpen" @cds-modal-closed="changeOpen = false">
        <cds-modal-header><cds-modal-close-button></cds-modal-close-button><cds-modal-heading x-text="changeTitle"></cds-modal-heading></cds-modal-header>
        <cds-modal-body><div class="stack">
            <p class="mono" x-show="selected" x-text="selected?.path"></p>
            <cds-select x-show="operation === 'create'" label-text="Type" x-cds-model="newType"><cds-select-item value="file">File</cds-select-item><cds-select-item value="directory">Folder</cds-select-item></cds-select>
            <cds-text-input :label="operation === 'permissions' ? 'Octal permissions' : 'Name'" :helper-text="operation === 'permissions' ? 'For example 0644 or 0755' : 'A single file or folder name, not a path'" x-cds-model="newValue" @keydown.enter.prevent="applyChange()"></cds-text-input>
        </div></cds-modal-body>
        <cds-modal-footer><cds-modal-footer-button kind="secondary" @click="changeOpen = false">Cancel</cds-modal-footer-button><cds-modal-footer-button :disabled="busy" @click="applyChange()">Save</cds-modal-footer-button></cds-modal-footer>
    </cds-modal>
    <cds-modal size="lg" x-cds-prop:open="editorOpen" @cds-modal-closed="editorOpen = false">
        <cds-modal-header><cds-modal-close-button></cds-modal-close-button><cds-modal-heading>File editor</cds-modal-heading><p class="mono" x-text="editingPath"></p></cds-modal-header>
        <cds-modal-body><div class="editor-frame"><div class="editor" x-ref="editor" aria-label="File content editor"></div></div><p class="muted">UTF-8 text, up to 2 MiB. Ctrl / Cmd + S saves.</p></cds-modal-body>
        <cds-modal-footer><cds-modal-footer-button kind="secondary" @click="editorOpen = false">Close</cds-modal-footer-button><cds-modal-footer-button :disabled="busy" @click="saveEditor()">Save changes</cds-modal-footer-button></cds-modal-footer>
    </cds-modal>
</section>
{{template "footer.template" .}}
