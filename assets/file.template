{{template "header.template"}}

<!-- Editor Modal -->
<div class="modal modal-open" x-show="editorShow" x-cloak>
    <div class="modal-box max-w-6xl p-0 overflow-hidden">
        <div class="row px-6 py-4 border-b border-base-300 bg-base-200/50">
            <div class="flex items-center gap-3">
                <span class="p-2 bg-primary/10 text-primary rounded-lg"><i class="ri-code-s-slash-line"></i></span>
                <div>
                    <h3 class="text-lg font-semibold">File Editor</h3>
                    <p class="text-xs opacity-60 font-mono" x-text="editor?.filename || 'Untitled'"></p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button @click.prevent="updateFile('update', editor.filename, editor.getSession().getValue())" class="btn btn-primary btn-sm">
                    <i class="ri-save-3-line"></i>Save Changes
                </button>
                <button @click="editorShow=false" class="btn btn-ghost btn-sm btn-circle"><i class="ri-close-line text-xl"></i></button>
            </div>
        </div>
        <div class="relative bg-[#272822]">
            <div id="editor" style="height: 600px; width: 100%;"></div>
        </div>
    </div>
    <div class="modal-backdrop" @click="editorShow=false"></div>
</div>

<div class="text-base-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h3 class="text-2xl font-bold tracking-tight flex items-center">
                <i class="ri-folder-3-line text-primary mr-3"></i>File Manager
            </h3>
            <p class="text-sm opacity-60 mt-1 ml-9">Browse, upload, and manage your server files</p>
        </div>
        <button @click="location.href='/admin/webdav'" class="hidden sm:flex btn btn-sm btn-outline btn-primary">
            <i class="ri-hard-drive-2-line"></i>WebDAV Access
        </button>
    </div>

    <div class="card surface p-4 mb-6">
        <div class="flex flex-col md:flex-row gap-4">
            <div class="flex-1 flex items-center bg-base-200 rounded-xl border border-base-300 p-1 focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all">
                <div class="flex items-center px-2 gap-1 border-r border-base-300 mr-2">
                    <button @click="homeHistory" title="Home" class="btn btn-ghost btn-sm btn-square"><i class="ri-home-4-line"></i></button>
                    <button @click="backHistory" title="Up Level" class="btn btn-ghost btn-sm btn-square"><i class="ri-arrow-up-line"></i></button>
                </div>
                <div class="flex-1 relative">
                    <i class="ri-folder-line absolute left-2 top-1/2 -translate-y-1/2 opacity-40"></i>
                    <input type="text" x-bind="inputHistory"
                           class="w-full pl-8 pr-4 py-2 bg-transparent border-none focus:ring-0 text-sm font-mono placeholder:opacity-40"
                           placeholder="/path/to/directory">
                </div>
                <button title="Refresh" @click="location.reload()" class="btn btn-ghost btn-sm btn-square mr-1"><i class="ri-refresh-line"></i></button>
            </div>

            <div class="flex items-center gap-3 shrink-0">
                <div class="relative" x-data="{ open: false }">
                    <button @click="open = !open" @click.away="open = false" class="btn btn-primary">
                        <i class="ri-add-line"></i>New<i class="ri-arrow-down-s-line opacity-70"></i>
                    </button>
                    <div x-show="open" x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         class="absolute right-0 mt-2 w-48 surface rounded-xl shadow-xl z-20 overflow-hidden">
                        <button @click.prevent="createFile('createFolder', prompt('Enter folder name', '')); open = false"
                                class="w-full px-4 py-3 text-left hover:bg-base-200 flex items-center gap-3 transition-colors text-sm">
                            <span class="p-1.5 bg-warning/15 text-warning rounded-md"><i class="ri-folder-add-line"></i></span>New Folder
                        </button>
                        <div class="h-px bg-base-300 mx-4"></div>
                        <button @click.prevent="createFile('createFile', prompt('Enter file name', '')); open = false"
                                class="w-full px-4 py-3 text-left hover:bg-base-200 flex items-center gap-3 transition-colors text-sm">
                            <span class="p-1.5 bg-info/15 text-info rounded-md"><i class="ri-file-add-line"></i></span>New File
                        </button>
                    </div>
                </div>

                <label class="btn btn-outline group cursor-pointer">
                    <i class="ri-upload-cloud-2-line text-primary group-hover:scale-110 transition-transform"></i>Upload
                    <input type="file" @change="uploadFiles($el)" multiple name="files" class="hidden">
                </label>
            </div>
        </div>
    </div>

    <div class="card surface overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                <tr>
                    <th class="w-10"><input type="checkbox" x-model="checkAll" class="checkbox checkbox-sm"></th>
                    <th>Name</th><th>Permissions</th><th>Size</th><th>Last Modified</th><th class="text-right">Actions</th>
                </tr>
                </thead>
                <tbody>
                <tr class="hover group">
                    <td></td>
                    <td colspan="5">
                        <button @click="backHistory" class="flex items-center gap-3 text-sm font-medium opacity-70 hover:text-primary transition-colors">
                            <i class="ri-corner-left-up-line text-lg opacity-60 group-hover:text-primary"></i>..
                        </button>
                    </td>
                </tr>

                {{range .Files}}
                    <tr class="hover group">
                        <td>
                            <input type="checkbox" x-init="$watch('checkAll', val => $el.checked=val)" class="checkbox checkbox-sm opacity-40 group-hover:opacity-100 transition-opacity">
                        </td>
                        <td>
                            <div class="flex items-center gap-3">
                                {{if .IsDir}}
                                    <span class="shrink-0 h-8 w-8 bg-warning/15 text-warning rounded-lg flex items-center justify-center"><i class="ri-folder-fill text-lg"></i></span>
                                    <button @click="changeDirectory($el.innerText)" class="font-medium hover:text-primary hover:underline underline-offset-2 transition-colors truncate max-w-[200px] sm:max-w-xs">{{.Name}}</button>
                                {{else}}
                                    <span class="shrink-0 h-8 w-8 bg-base-200 rounded-lg flex items-center justify-center opacity-70"><i class="ri-file-text-line text-lg"></i></span>
                                    <a :href="`/admin/file/process?path=${getDirectoryValue()}/{{.Name}}`" class="font-medium hover:text-primary hover:underline underline-offset-2 transition-colors truncate max-w-[200px] sm:max-w-xs">{{.Name}}</a>
                                {{end}}
                            </div>
                        </td>
                        <td><span class="badge badge-ghost badge-sm font-mono">{{.Mode.Perm}}</span></td>
                        <td class="opacity-60 tabular-nums" x-text="formatBytes(`{{.Size}}`)"></td>
                        <td class="opacity-60 tabular-nums">{{.ModTime.Format "2006-01-02 15:04"}}</td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                {{if not .IsDir}}
                                    <button @click.prevent="newEditor(`{{.Name}}`)" class="btn btn-ghost btn-xs text-info" title="Edit"><i class="ri-edit-box-line text-lg"></i></button>
                                {{end}}
                                <button @click.prevent="updateFile('rename', `{{.Name}}`,prompt('Enter new name', `{{.Name}}`))" class="btn btn-ghost btn-xs text-warning" title="Rename"><i class="ri-input-method-line text-lg"></i></button>
                                <button @click.prevent="updateFile('chmod', `{{.Name}}`, prompt('Set permissions (e.g., 0644)', ''))" class="btn btn-ghost btn-xs text-primary" title="Permissions"><i class="ri-shield-keyhole-line text-lg"></i></button>
                                <div class="h-4 w-px bg-base-300 mx-1"></div>
                                <button @click.prevent="deleteFile(`{{.Name}}`)" class="btn btn-ghost btn-xs text-error" title="Delete"><i class="ri-delete-bin-5-line text-lg"></i></button>
                            </div>
                        </td>
                    </tr>
                {{end}}
                </tbody>
            </table>
        </div>

        <template x-if="!{{len .Files}} && '{{len .Files}}' != '0'">
            <div class="px-6 py-4 border-t border-base-300 bg-base-200/50">
                <p class="text-xs opacity-60 text-center">End of file list</p>
            </div>
        </template>
    </div>
</div>

<script type="text/javascript" src="/assets/js/ace.js"></script>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('panel', () => ({
            checkAll: false,
            directory: {{printf "%q" .Dir}},
            editorShow: false,

            formatBytes(bytes, decimals = 2) {
                if (bytes === '0' || bytes === 0) return '0 B';
                const k = 1024;
                const dm = decimals < 0 ? 0 : decimals;
                const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
            },

            getDirectoryValue() {
                return this.directory || '/';
            },

            setDirectory(directory) {
                this.directory = directory || '/';
                document.cookie = `dirHistory=${encodeURIComponent(this.directory)}`;
                location.reload();
            },

            filePath(name = '') {
                const current = this.getDirectoryValue().replace(/\/+$/, '') || '/';
                if (!name) return current;
                return `${current === '/' ? '' : current}/${name}`;
            },

            processURL(name = '', mode = '') {
                const url = new URL('/admin/file/process', location.origin);
                url.searchParams.set('path', this.filePath(name));
                if (mode) url.searchParams.set('mode', mode);
                return url;
            },

            async message(res) {
                const text = await res.text();
                if (!text) return '';
                try {
                    const data = JSON.parse(text);
                    return data.message || data;
                } catch {
                    return text;
                }
            },

            async request(options = {}) {
                const {name = '', mode = '', ...init} = options;
                const res = await fetch(this.processURL(name, mode), init);
                if (!res.ok) throw new Error(await this.message(res));
                return res;
            },

            async run(options, fallback = 'Operation failed') {
                try {
                    const res = await this.request(options);
                    alert(await this.message(res) || 'success');
                    location.reload();
                } catch (error) {
                    alert(`${fallback}: ${error.message}`);
                }
            },

            inputHistory: {
                'x-ref': 'inputHistory',
                'x-init'() {
                    this.$refs.inputHistory.value = this.getDirectoryValue();
                },
                '@blur'() {
                    this.setDirectory(this.$refs.inputHistory.value);
                },
                '@keydown.enter'() {
                    this.setDirectory(this.$refs.inputHistory.value);
                }
            },

            changeDirectory(name) {
                this.setDirectory(this.filePath(name));
            },

            homeHistory() {
                this.setDirectory('/');
            },

            backHistory() {
                const current = this.getDirectoryValue();
                const index = current.lastIndexOf('/');
                this.setDirectory(index <= 0 ? '/' : current.substring(0, index));
            },

            async newEditor(name) {
                try {
                    const res = await this.request({name, mode: 'edit'});
                    const data = await res.json();
                    window.editor = ace.edit("editor");
                    editor.setValue(data.data, -1);
                    editor.filename = name;
                    editor.session.setMode(`ace/mode/${data.type}`);
                    this.editorShow = true;
                } catch (error) {
                    alert('Failed to open editor: ' + error.message);
                }
            },

            async uploadFiles(el) {
                const formData = new FormData();
                Array.from(el.files).forEach(file => formData.append('files', file));
                await this.run({method: 'POST', body: formData}, 'Upload failed');
            },

            async updateFile(type, name, data) {
                if (!data) return;
                const body = type === 'rename' ? this.filePath(data) : data;
                await this.run({
                    name,
                    mode: type,
                    method: 'PUT',
                    headers: {'Content-Type': 'text/plain'},
                    body,
                }, 'Update failed');
            },

            async deleteFile(name) {
                if (confirm("Are you sure you want to delete this file?")) {
                    await this.run({name, method: 'DELETE'}, 'Delete failed');
                }
            },

            async createFile(type, name) {
                if (!name) return;
                await this.run({name, mode: type, method: 'PUT'}, 'Create failed');
            }
        }))
    })
</script>
{{template "footer.template"}}
