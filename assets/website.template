{{template "header.template"}}

<div class="text-base-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" x-data="panel">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h3 class="text-2xl font-bold tracking-tight flex items-center">
                <i class="ri-global-line text-primary mr-3"></i>Website Manage
            </h3>
            <p class="text-sm opacity-60 mt-1 ml-9">Configure your Caddy web server</p>
        </div>

        <label class="surface rounded-xl px-5 py-2.5 flex items-center gap-4 cursor-pointer">
            <div class="flex flex-col items-end">
                <span class="eyebrow">Service Boot</span>
                <span class="text-[11px] font-bold" :class="caddyEnabled ? 'text-success' : 'opacity-50'"
                      x-text="caddyEnabled ? 'ENABLED' : 'DISABLED'"></span>
            </div>
            <input type="checkbox" class="toggle toggle-success" :checked="caddyEnabled" @change="manageCaddy('enable')">
        </label>
    </div>

    <div class="surface rounded-2xl p-4 mb-6 flex flex-wrap gap-3 items-center justify-between">
        <div class="flex flex-wrap gap-2">
            <button @click="manageCaddy('restart')" class="btn btn-sm btn-outline group">
                <i class="ri-restart-line text-primary group-hover:rotate-180 transition-transform duration-500"></i>Restart Service
            </button>
            <button @click="manageCaddy('stop')" class="btn btn-sm btn-outline btn-error">
                <i class="ri-stop-circle-line"></i>Stop Service
            </button>
        </div>
        <button @click="updateConfig" class="btn btn-sm btn-primary ml-auto">
            <i class="ri-save-3-line text-lg"></i>Save Configuration
        </button>
    </div>

    <div class="card surface overflow-hidden flex flex-col h-[calc(100vh-300px)] min-h-[500px]">
        <div class="row px-6 py-3 border-b border-base-300 bg-base-200/40">
            <div class="flex items-center gap-2">
                <i class="ri-code-s-slash-line opacity-50"></i>
                <span class="text-sm font-semibold">Caddyfile</span>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <span class="opacity-60 hidden sm:flex items-center"><i class="ri-command-line mr-1"></i>Cmd/Ctrl + S to save</span>
                <a href="https://caddyserver.com/docs/caddyfile" target="_blank"
                   class="link link-hover text-primary font-medium flex items-center">
                    <i class="ri-book-open-line mr-1.5"></i>Docs
                </a>
            </div>
        </div>
        <div class="relative flex-1 w-full bg-[#272822]">
            <div id="editor" class="absolute inset-0 w-full h-full text-base"></div>
        </div>
    </div>
</div>

<script type="text/javascript" src="/assets/js/ace.js"></script>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('panel', () => ({
            // Initialize with Go Template value
            caddyEnabled: {{.caddyEnable}},

            init() {
                window.editor = ace.edit("editor");
                editor.setTheme("ace/theme/monokai");
                editor.setOptions({
                    fontSize: "14px",
                    showPrintMargin: false,
                    showGutter: true,
                    highlightActiveLine: true,
                    wrap: true,
                    fontFamily: "'JetBrains Mono', 'Fira Code', monospace"
                });
                editor.setValue(`{{.caddyFile}}`, -1);

                editor.commands.addCommand({
                    name: 'save',
                    bindKey: {win: 'Ctrl-S', mac: 'Command-S'},
                    exec: () => {
                        this.updateConfig();
                    }
                });
            },

            async updateConfig() {
                try {
                    // Show simple loading state if needed
                    const response = await fetch(`/admin/website`, {
                        method: 'PUT',
                        body: editor.getSession().getValue(),
                    });
                    const result = await response.text();
                    alert(result);
                    location.reload();
                } catch (error) {
                    alert('Failed to update config: ' + error.message);
                }
            },

            async manageCaddy(status) {
                // Optimistic UI update for the toggle (feels faster)
                if (status === 'enable') {
                    this.caddyEnabled = !this.caddyEnabled;
                }

                try {
                    const response = await fetch(`/admin/website?status=${status}`, {
                        method: "POST"
                    });
                    const result = await response.text();

                    // If using alert/reload, keep it.
                    // If you want a smoother experience, remove reload and use a toast notification.
                    alert(result);
                    location.reload();
                } catch (error) {
                    // Revert state if failed
                    if (status === 'enable') this.caddyEnabled = !this.caddyEnabled;
                    alert('Operation failed: ' + error.message);
                }
            }
        }))
    })
</script>
{{template "footer.template"}}