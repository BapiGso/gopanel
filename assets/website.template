{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/toggle.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/link.min.js"></script>
<script defer src="/assets/js/ace.js"></script>
<script defer src="/assets/js/mode-caddyfile.js"></script>
<script defer src="/assets/js/pages/website.js"></script>
<section class="page" x-data="websitePage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-inline-notification low-contrast x-show="status.last_error" x-cloak kind="error" title="Service error" :subtitle="status.last_error" hide-close-button></cds-inline-notification>
    <div class="toolbar">
        <cds-button size="md" kind="ghost" :disabled="busy" @click="manage('start')">Start</cds-button>
        <cds-button size="md" kind="ghost" :disabled="busy" @click="manage('reload')">Reload</cds-button>
        <cds-button size="md" kind="ghost" :disabled="busy" @click="manage('stop')">Stop</cds-button>
        <cds-toggle hidelabel label-text="Autostart" label-a="Autostart on" label-b="Autostart off" :disabled="busy" x-cds-prop:toggled="status.autostart" @cds-toggle-changed="autostart($event.target.toggled)"></cds-toggle>
        <span x-show="status.pending_changes" class="cds--type-label-01 muted">Saved changes not applied</span>
    </div>
    <div class="editor-frame">
        <div class="toolbar">
            <div class="editor-title"><h2 class="cds--type-code-02">Caddyfile</h2><p class="cds--type-label-01 muted">Ctrl / Cmd + S to save</p></div>
            <cds-button size="md" kind="ghost" :disabled="busy" @click="reloadDocument()">Read saved file</cds-button>
            <cds-button size="md" :disabled="busy" @click="save()">Save configuration<span slot="icon">{{icon "save" 16}}</span></cds-button>
        </div>
        <div class="editor" x-ref="editor" aria-label="Caddyfile editor"></div>
    </div>
    <p class="muted">Saving validates the file but does not apply it. Start or reload to apply the saved revision. Autostart does not change the running service.</p>
</section>
{{template "footer.template" .}}
