{{template "public-header.template" .}}
<section class="page empty-state" x-data="warningPage" data-page="{{.Page}}">
    {{icon "warning--01" 64}}
    <h1 class="cds--type-heading-04">Access denied</h1>
    <p>Sign in through your configured private login path to access GoPanel.</p>
    <cds-tile class="stack"><h2>Find your login path</h2><p>Check the Panel.Path setting in gopanel_config.json on the server. A new installation generates a random login path; do not share it publicly.</p><p class="muted" x-text="message"></p><p class="mono" x-text="ip ? 'Client IP: ' + ip : ''"></p></cds-tile>
    <cds-link href="/status/monitor">View public monitoring, if enabled</cds-link>
</section>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tile.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/link.min.js"></script>
<script defer src="/assets/js/pages/warning.js"></script>
{{template "footer.template" .}}
