{{template "observatory.head" .}}

<main class="mx-auto max-w-7xl px-4 pb-4 pt-7 sm:px-8 sm:pt-9 [&_.card]:rounded-2xl">
    <header class="flex flex-wrap items-center justify-between gap-4">
        <a href="/status/monitor" class="flex items-center gap-3">
            <span class="avatar placeholder"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-success/10 text-xl text-success">◈</span></span>
            <span class="font-semibold tracking-tight" x-text="title">GoPanel Observatory</span>
        </a>
        <div class="flex items-center gap-2">
            <span class="badge badge-sm gap-2 border-base-300" :class="connected ? 'badge-success badge-outline' : 'badge-warning badge-outline'"><span class="h-1.5 w-1.5 rounded-full bg-current" :class="connected && 'animate-pulse'"></span><span x-text="connected ? '实时连接' : '连接中'"></span></span>
            <a x-show="!publicView" href="/admin/security" class="btn btn-circle btn-ghost btn-sm" title="返回管理面板">⌂</a>
            <button class="btn btn-circle btn-ghost btn-sm text-lg" @click="toggleTheme" aria-label="切换主题" x-text="dark ? '☾' : '☀'"></button>
        </div>
    </header>

    <section class="mb-7 mt-12 flex flex-wrap items-end justify-between gap-4 sm:mt-16">
        <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-[0.22em] text-success">Your infrastructure, at a glance</p>
            <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">全球节点概览<span class="ml-2 inline-block h-2 w-2 rounded-full bg-success align-middle" :class="connected && 'animate-pulse'"></span></h1>
            <p class="mt-2 text-xs text-base-content/45">最近采样 <span class="ml-1 font-mono text-base-content/70" x-text="lastUpdated">—</span><span class="mx-2">·</span><span x-text="clusterLabel"></span></p>
        </div>
    </section>

    <div x-show="error" class="alert alert-warning mb-6 py-3 text-xs" role="status"><span x-text="error"></span></div>
    <div x-show="overview.cluster.coordination === 'manual' && overview.cluster.degraded" class="alert alert-warning mb-6 py-3 text-xs" role="status"><span>部分探针尚未连接或已经失联，请检查汇总机到探针的网络、9555 端口和共享监控密钥；列表保留最近一次有效采样。</span></div>

    <section class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5" aria-label="监控概况">
        <div class="card border border-base-300 bg-base-200/60 shadow-sm"><div class="card-body gap-3 p-5"><div class="flex items-center gap-2 text-sm text-base-content/70"><span>▤</span><span>服务器总数</span></div><div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-info"></span><span class="font-mono text-2xl font-semibold" x-text="loading ? '—' : overview.total"></span></div></div></div>
        <div class="card border border-base-300 bg-base-200/60 shadow-sm"><div class="card-body gap-3 p-5"><div class="flex items-center gap-2 text-sm text-base-content/70"><span>⊙</span><span>在线服务器</span></div><div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-success shadow-sm shadow-success/30"></span><span class="font-mono text-2xl font-semibold" x-text="loading ? '—' : overview.online"></span></div></div></div>
        <div class="card border border-base-300 bg-base-200/60 shadow-sm"><div class="card-body gap-3 p-5"><div class="flex items-center gap-2 text-sm text-base-content/70"><span>⊗</span><span>离线服务器</span></div><div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-error"></span><span class="font-mono text-2xl font-semibold" x-text="loading ? '—' : overview.offline"></span></div></div></div>
        <div class="card border border-base-300 bg-base-200/60 shadow-sm"><div class="card-body gap-2 p-5"><div class="flex items-center gap-2 text-sm text-base-content/70"><span>◎</span><span>网络流量</span></div><div class="flex flex-wrap gap-3 font-mono text-sm font-semibold"><span class="text-info" x-text="'↑ ' + bytes(overview.upload_bytes)"></span><span class="text-secondary" x-text="'↓ ' + bytes(overview.download_bytes)"></span></div><div class="flex flex-wrap gap-3 font-mono text-xs text-base-content/60"><span x-text="'↑ ' + rate(overview.upload_rate)"></span><span x-text="'↓ ' + rate(overview.download_rate)"></span></div><span class="text-[10px] text-base-content/35">接口累计计数 · 非账单统计</span></div></div>
    </section>

    <section class="mt-7 flex flex-wrap items-center justify-between gap-4" aria-label="节点筛选">
        <div class="flex min-w-0 items-center gap-3">
            <div class="join shrink-0"><button class="btn join-item btn-sm px-3" :class="showMap ? 'btn-success' : 'btn-ghost'" @click="toggleMap" aria-label="显示或隐藏地图">◎</button><button class="btn join-item btn-sm px-3" :class="!showMap ? 'btn-success' : 'btn-ghost'" @click="hideMap" aria-label="仅显示列表">▥</button></div>
            <div role="tablist" class="tabs tabs-boxed max-w-[70vw] flex-nowrap overflow-x-auto rounded-full p-1 text-xs"><template x-for="tag in tags" :key="tag"><button role="tab" class="tab h-8 whitespace-nowrap rounded-full px-4 text-xs" :class="selectedTag === tag && 'tab-active'" @click="selectTag(tag)" x-text="tag === 'All' ? '全部节点' : tag"></button></template></div>
        </div>
        <div class="flex items-center gap-2">
            <input x-ref="search" x-model.debounce.150ms="search" type="search" placeholder="搜索节点 / 区域" aria-label="搜索节点" class="input input-sm input-bordered w-40 text-xs sm:w-48">
            <select x-model="sort" class="select select-sm select-bordered text-xs" aria-label="节点排序"><option value="name">名称排序</option><option value="cpu">CPU 使用</option><option value="memory">内存使用</option><option value="traffic">实时流量</option><option value="online">在线优先</option></select>
        </div>
    </section>

    <section x-show="showMap" class="relative mt-7 overflow-hidden rounded-2xl border border-base-300 bg-base-200/20" aria-label="全球节点地图">
        <div class="absolute left-5 top-4 z-10 flex flex-wrap items-center gap-3 text-xs"><span class="text-base-content/50">服务器分布在 <strong class="font-mono font-normal text-base-content/80" x-text="visibleCountries"></strong> 个国家 / 区域</span><button x-show="selectedCountry" class="badge badge-outline badge-sm cursor-pointer gap-2" @click="clearCountry"><span x-text="countryName(selectedCountry)"></span><span>×</span></button></div>
        <div id="world-map" x-ref="map" class="h-[320px] w-full sm:h-[430px] lg:h-[500px]"></div>
        <div x-show="!mapReady" class="absolute inset-0 flex items-center justify-center p-8 text-center"><div><span x-show="!mapError" class="loading loading-spinner loading-sm text-success"></span><p class="mt-3 text-xs text-base-content/50" x-text="mapError || '正在加载世界地图'"></p></div></div>
        <div class="absolute bottom-4 left-5 flex gap-4 text-[10px] text-base-content/40"><span class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-success"></span>在线区域</span><span class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-error"></span>离线区域</span><span>位置由节点配置提供，不自动查询外部 GeoIP</span></div>
    </section>

    <section class="mt-7" aria-label="服务器列表">
        <div class="mb-3 flex items-center justify-between text-xs text-base-content/40"><span><span class="font-mono" x-text="filteredNodes.length"></span> 台节点<span x-show="selectedCountry"> · <span x-text="countryName(selectedCountry)"></span></span></span><span>点击节点查看详情</span></div>
        <div x-show="loading" class="space-y-3"><div class="skeleton h-24 w-full rounded-2xl"></div><div class="skeleton h-24 w-full rounded-2xl"></div></div>
        <div x-show="!loading && !filteredNodes.length" class="card border border-dashed border-base-300 bg-base-200/30"><div class="card-body items-center py-12 text-center"><span class="text-3xl text-success/70">◎</span><h2 class="card-title text-base" x-text="overview.total ? '没有符合筛选条件的节点' : '等待第一台节点连接'"></h2><p class="max-w-lg text-xs leading-relaxed text-base-content/45">这里只显示真实采样。汇总机读取 peers 中的探针；名称、分组和地理位置可在各节点的 gopanel_monitor.json 中选填。</p></div></div>
        <div class="space-y-2.5">
            <template x-for="node in pageNodes" :key="node.id">
                <button class="card block w-full overflow-hidden border border-base-300 bg-base-200/50 text-left shadow-sm transition-colors hover:border-success/40 hover:bg-base-200" @click="openNode(node)" :aria-label="'查看 ' + node.name">
                    <div class="overflow-x-auto"><div class="grid min-w-[980px] grid-cols-[210px_85px_85px_80px_80px_80px_85px_85px_100px_100px] items-center gap-4 px-5 py-5 lg:min-w-0 lg:grid-cols-[minmax(150px,1.7fr)_repeat(9,minmax(55px,1fr))] lg:gap-3">
                        <div class="flex min-w-0 items-center gap-3 border-r border-base-300 pr-4"><span class="h-2 w-2 shrink-0 rounded-full" :class="node.online ? 'bg-success' : 'bg-error'"></span><span class="shrink-0 text-base" x-text="flag(node.country)"></span><div class="min-w-0"><p class="truncate text-xs font-semibold" x-text="node.name"></p><p x-show="node.price" class="mt-0.5 truncate text-[10px] text-base-content/40" x-text="'价格: ' + node.price"></p><p x-show="node.expires_at" class="mt-0.5 text-[10px] text-base-content/40" x-text="expiry(node.expires_at)"></p><div class="mt-1 flex gap-1"><template x-for="tag in node.tags.slice(0, 2)" :key="tag"><span class="badge badge-xs border-0 bg-base-300 text-[9px]" x-text="tag"></span></template></div></div></div>
                        <div><p class="text-[10px] text-base-content/40">系统</p><p class="mt-1 truncate text-xs font-semibold capitalize" x-text="node.metrics.platform || '—'"></p></div>
                        <div><p class="text-[10px] text-base-content/40">运行时间</p><p class="mt-1 font-mono text-xs font-semibold" x-text="uptime(node.metrics.uptime_seconds)"></p></div>
                        <div><p class="text-[10px] text-base-content/40">CPU</p><p class="mt-1 font-mono text-xs font-semibold" x-text="percent(node, 'cpu')"></p><progress class="progress mt-1 h-1 w-14" :class="level(node.metrics.cpu_percent)" :value="node.metrics.cpu_percent" max="100"></progress></div>
                        <div><p class="text-[10px] text-base-content/40">内存</p><p class="mt-1 font-mono text-xs font-semibold" x-text="percent(node, 'memory')"></p><progress class="progress mt-1 h-1 w-14" :class="level(node.metrics.memory_percent)" :value="node.metrics.memory_percent" max="100"></progress></div>
                        <div><p class="text-[10px] text-base-content/40">存储</p><p class="mt-1 font-mono text-xs font-semibold" x-text="percent(node, 'disk')"></p><progress class="progress mt-1 h-1 w-14" :class="level(node.metrics.disk_percent)" :value="node.metrics.disk_percent" max="100"></progress></div>
                        <div><p class="text-[10px] text-base-content/40">上传</p><p class="mt-1 whitespace-nowrap font-mono text-xs font-semibold" x-text="node.online && node.metrics.rate_available ? rate(node.metrics.upload_rate) : '—'"></p></div>
                        <div><p class="text-[10px] text-base-content/40">下载</p><p class="mt-1 whitespace-nowrap font-mono text-xs font-semibold" x-text="node.online && node.metrics.rate_available ? rate(node.metrics.download_rate) : '—'"></p></div>
                        <div><p class="text-[10px] text-base-content/40">总上传</p><p class="mt-1 whitespace-nowrap font-mono text-xs font-semibold" x-text="bytes(node.metrics.upload_bytes)"></p></div>
                        <div><p class="text-[10px] text-base-content/40">总下载</p><p class="mt-1 whitespace-nowrap font-mono text-xs font-semibold" x-text="bytes(node.metrics.download_bytes)"></p></div>
                    </div></div>
                </button>
            </template>
        </div>
    </section>

    <nav x-show="pageCount > 1" class="mt-5 flex flex-wrap items-center justify-between gap-3 text-xs text-base-content/50" aria-label="节点分页">
        <span>每页最多 <span x-text="pageSize"></span> 台 · 地图与统计包含所有节点</span>
        <div class="join"><button class="btn btn-sm join-item" :disabled="page === 1" @click="changePage(-1)">上一页</button><span class="btn btn-sm join-item pointer-events-none font-mono" x-text="page + ' / ' + pageCount"></span><button class="btn btn-sm join-item" :disabled="page === pageCount" @click="changePage(1)">下一页</button></div>
    </nav>

    <p x-show="overview.cluster?.coordination === 'best_effort'" class="mt-6 text-center text-[10px] leading-relaxed text-base-content/30">候选节点按配置顺序选择首个可达的汇总节点；网络分区可能产生多个只读视图，不承担任何管理选主或远程执行功能。</p>
    <p x-show="overview.cluster.coordination === 'manual'" class="mt-6 text-center text-[10px] leading-relaxed text-base-content/30">汇总机由人工指定，主动读取配置中的探针 IP；探针接口只提供缓存指标，不提供系统配置或远程执行。</p>

    <dialog x-ref="details" class="modal" @close="closeDetails">
        <div class="modal-box max-w-2xl border border-base-300 bg-base-100">
            <form method="dialog"><button class="btn btn-circle btn-ghost btn-sm absolute right-3 top-3" aria-label="关闭详情">✕</button></form>
            <template x-if="selectedNode"><div>
                <div class="mb-7 flex items-center gap-3"><span class="text-3xl" x-text="flag(selectedNode.country)"></span><div><h2 class="text-lg font-semibold" x-text="selectedNode.name"></h2><p class="mt-1 text-xs text-base-content/45" x-text="[countryName(selectedNode.country), selectedNode.region].filter(Boolean).join(' · ')"></p></div></div>
                <div class="stats stats-vertical mb-5 w-full border border-base-300 bg-base-200 sm:stats-horizontal"><div class="stat"><div class="stat-title text-xs">CPU</div><div class="stat-value text-2xl font-mono" x-text="percent(selectedNode, 'cpu')"></div><div class="stat-desc" x-text="selectedNode.metrics.cpu_cores + ' 核 · ' + selectedNode.metrics.architecture"></div></div><div class="stat"><div class="stat-title text-xs">内存</div><div class="stat-value text-2xl font-mono" x-text="percent(selectedNode, 'memory')"></div><div class="stat-desc" x-text="bytes(selectedNode.metrics.memory_used) + ' / ' + bytes(selectedNode.metrics.memory_total)"></div></div><div class="stat"><div class="stat-title text-xs">存储</div><div class="stat-value text-2xl font-mono" x-text="percent(selectedNode, 'disk')"></div><div class="stat-desc" x-text="bytes(selectedNode.metrics.disk_used) + ' / ' + bytes(selectedNode.metrics.disk_total)"></div></div></div>
                <div class="grid grid-cols-2 gap-5 text-xs"><div><p class="text-base-content/40">节点状态</p><p class="mt-2" :class="selectedNode.online ? 'text-success' : 'text-error'" x-text="selectedNode.online ? '在线' : '失联 / 离线'"></p></div><div><p class="text-base-content/40">运行时间</p><p class="mt-2 font-mono" x-text="uptime(selectedNode.metrics.uptime_seconds)"></p></div><div><p class="text-base-content/40">最近上报</p><p class="mt-2 font-mono" x-text="timestamp(selectedNode.last_seen)"></p></div><div><p class="text-base-content/40">节点标识</p><p class="mt-2 break-all font-mono text-base-content/60" x-text="selectedNode.id"></p></div></div>
                <div class="divider text-[10px] text-base-content/35">最近采样 · 内存中的有限历史</div>
                <div x-show="historyLoading" class="flex justify-center py-4"><span class="loading loading-dots loading-sm text-success"></span></div>
                <div x-show="!historyLoading" class="overflow-x-auto rounded-xl border border-base-300 bg-base-200"><table class="table table-xs"><thead><tr><th>时间</th><th>CPU</th><th>内存</th><th>上传</th><th>下载</th></tr></thead><tbody><template x-for="(sample, index) in history" :key="index"><tr class="font-mono text-xs"><td x-text="timestamp(sample.time)"></td><td x-text="sample.cpu_percent.toFixed(1) + '%'"></td><td x-text="sample.memory_percent.toFixed(1) + '%'"></td><td x-text="rate(sample.upload_rate)"></td><td x-text="rate(sample.download_rate)"></td></tr></template></tbody></table></div>
                <p class="mt-4 text-[10px] text-base-content/35">公开页面不提供命令执行、系统配置、真实 IP、主机名、进程列表或磁盘路径。</p>
            </div></template>
        </div>
        <form method="dialog" class="modal-backdrop"><button>关闭</button></form>
    </dialog>
</main>

{{template "observatory.footer" .}}
