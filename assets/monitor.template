{{template "header.template"}}

<div class="text-base-content max-w-7xl mx-auto" x-data="panel">

    <div class="row mb-6">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">System Monitor</h1>
            <p class="text-sm opacity-60 mt-1">Real-time server metrics · 2s refresh</p>
        </div>
        <div class="badge badge-lg badge-outline gap-2" role="status"
             :class="isConnected ? 'badge-success' : 'badge-error'"
             :aria-label="isConnected ? 'System is live' : 'System is offline'">
            <span class="h-2 w-2 rounded-full bg-current" :class="isConnected && 'animate-pulse'"></span>
            <span x-text="isConnected ? 'Live' : 'Offline'"></span>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-6">

        <template x-for="g in gauges" :key="g.label">
            <div class="card surface">
                <div class="card-body !p-5 items-center">
                    <div class="row eyebrow w-full">
                        <span x-text="g.label"></span>
                        <i :class="g.icon" class="text-base"></i>
                    </div>
                    <div class="radial-progress my-3 font-mono text-2xl font-bold" :class="levelText(g.value)"
                         :style="`--value:${g.value};--size:7.5rem;--thickness:.5rem`"
                         role="progressbar" :aria-valuenow="g.value" aria-valuemin="0" aria-valuemax="100"
                         x-text="g.value + '%'"></div>
                    <p class="text-xs opacity-60 truncate w-full text-center" :title="g.desc" x-text="g.desc"></p>
                </div>
            </div>
        </template>

        <div class="card surface">
            <div class="card-body !p-5 gap-3">
                <div class="row eyebrow"><span>Disk</span><i class="ri-hard-drive-2-line text-base"></i></div>

                <template x-for="d in visibleDisks" :key="d.path">
                    <div>
                        <div class="row text-xs mb-1">
                            <span class="truncate" :title="`${d.device} (${d.fstype})`" x-text="d.path"></span>
                            <span class="font-mono opacity-60 shrink-0" x-text="`${fmtBytes(d.used)} / ${fmtBytes(d.total)}`"></span>
                        </div>
                        <progress class="progress" :class="levelBar(d.usedPercent)" :value="Math.round(d.usedPercent)" max="100"></progress>
                    </div>
                </template>

                <p x-show="!disks.length" class="text-xs italic opacity-60">No disk data</p>

                <button class="btn btn-ghost btn-xs" x-show="disks.length > 3" @click="showAllDisks = !showAllDisks">
                    <span x-text="showAllDisks ? 'Show less' : `Show all (${disks.length})`"></span>
                    <i class="ri-arrow-down-s-line transition-transform" :class="showAllDisks && 'rotate-180'"></i>
                </button>
            </div>
        </div>

        <div class="card surface">
            <div class="card-body !p-5 gap-3">
                <div class="row eyebrow"><span>Network</span><i class="ri-global-line text-base"></i></div>

                <template x-for="n in visibleNets" :key="n.name">
                    <div class="row text-xs" :title="`Total ↓ ${fmtBytes(n.bytesRecv)} · ↑ ${fmtBytes(n.bytesSent)}`">
                        <span class="truncate" x-text="n.name"></span>
                        <span class="flex gap-3 font-mono shrink-0">
                            <span class="text-success" x-text="'↓ ' + fmtRate(rates[n.name]?.down)"></span>
                            <span class="text-info" x-text="'↑ ' + fmtRate(rates[n.name]?.up)"></span>
                        </span>
                    </div>
                </template>

                <p x-show="!nets.length" class="text-xs italic opacity-60">No data</p>

                <button class="btn btn-ghost btn-xs" x-show="nets.length > 3" @click="showAllNets = !showAllNets">
                    <span x-text="showAllNets ? 'Show less' : `Show all (${nets.length})`"></span>
                    <i class="ri-arrow-down-s-line transition-transform" :class="showAllNets && 'rotate-180'"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="stats surface w-full overflow-x-auto">
        <div class="stat">
            <div class="stat-figure text-indigo-500"><i class="ri-terminal-window-line text-3xl"></i></div>
            <div class="stat-title">OS Platform</div>
            <div class="stat-value !text-lg capitalize" x-text="host.platform || 'N/A'"></div>
            <div class="stat-desc font-mono" x-text="host.kernelArch || ''"></div>
        </div>
        <div class="stat">
            <div class="stat-figure text-emerald-500"><i class="ri-time-line text-3xl"></i></div>
            <div class="stat-title">Uptime</div>
            <div class="stat-value !text-lg font-mono" x-text="fmtUptime(host.uptime)"></div>
            <div class="stat-desc" x-text="host.hostname || ''"></div>
        </div>
        <div class="stat">
            <div class="stat-figure text-amber-500"><i class="ri-database-2-line text-3xl"></i></div>
            <div class="stat-title">Memory</div>
            <div class="stat-value !text-lg font-mono" x-text="data?.Memory ? fmtBytes(data.Memory.total) : 'N/A'"></div>
            <div class="stat-desc" x-text="data?.Memory ? `${fmtBytes(data.Memory.available)} available` : ''"></div>
        </div>
        <div class="stat">
            <div class="stat-figure text-rose-500"><i class="ri-microchip-line text-3xl"></i></div>
            <div class="stat-title">Processor</div>
            <div class="stat-value !text-lg truncate" :title="cpuModel" x-text="cpuModel"></div>
            <div class="stat-desc" x-text="`${data?.CPU?.[0]?.cores || 0} cores`"></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('panel', () => ({
            data: {},
            isConnected: false,
            rates: {},
            prevNet: null,
            showAllDisks: false,
            showAllNets: false,

            init() {
                const es = new EventSource('/admin/monitor?type=info');
                es.onopen = () => this.isConnected = true;
                es.onerror = () => this.isConnected = false;
                es.onmessage = (e) => {
                    try {
                        this.ingest(JSON.parse(e.data));
                        this.isConnected = true;
                    } catch (err) {
                        console.error('monitor: bad SSE payload', err);
                    }
                };
            },

            // 接收一帧数据；网络字段是开机以来的累计字节数，与上一帧做差得出实时速率
            ingest(d) {
                const now = Date.now();
                if (this.prevNet) {
                    const dt = (now - this.prevNet.t) / 1000;
                    if (dt > 0.5) {
                        const rates = {};
                        for (const n of d.Network || []) {
                            const p = this.prevNet.map[n.name];
                            if (p) rates[n.name] = {
                                down: Math.max(0, n.bytesRecv - p.recv) / dt,
                                up: Math.max(0, n.bytesSent - p.sent) / dt,
                            };
                        }
                        this.rates = rates;
                    }
                }
                this.prevNet = {
                    t: now,
                    map: Object.fromEntries((d.Network || []).map(n => [n.name, { recv: n.bytesRecv, sent: n.bytesSent }])),
                };
                this.data = d;
            },

            get cpu() { return Math.round(this.data?.CPUUsage?.[0] ?? 0); },
            get mem() { return Math.round(this.data?.Memory?.usedPercent ?? 0); },
            get cpuModel() { return (this.data?.CPU?.[0]?.modelName || 'Loading...').replace(/\s+/g, ' '); },
            get host() { return this.data?.HostInfo || {}; },
            get disks() { return this.data?.DiskUsage || []; },
            get nets() { return (this.data?.Network || []).filter(n => n.bytesRecv > 0 || n.bytesSent > 0); },
            get visibleDisks() { return this.showAllDisks ? this.disks : this.disks.slice(0, 3); },
            get visibleNets() { return this.showAllNets ? this.nets : this.nets.slice(0, 3); },

            get gauges() {
                const m = this.data?.Memory;
                return [
                    { label: 'CPU Load', icon: 'ri-cpu-line', value: this.cpu, desc: this.cpuModel },
                    { label: 'RAM Usage', icon: 'ri-database-2-line', value: this.mem,
                      desc: m ? `${this.fmtBytes(m.used)} / ${this.fmtBytes(m.total)}` : '—' },
                ];
            },

            levelText(v) {
                if (v >= 90) return 'text-error';
                if (v >= 70) return 'text-warning';
                return 'text-success';
            },
            levelBar(v) {
                if (v >= 90) return 'progress-error';
                if (v >= 70) return 'progress-warning';
                return 'progress-success';
            },

            fmtUptime(s) {
                if (!s) return 'N/A';
                const d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
                return d > 0 ? `${d}d ${h}h ${m}m` : `${h}h ${m}m`;
            },
            fmtBytes(bytes, decimals = 1) {
                if (!bytes) return '0 B';
                const k = 1024, sizes = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
                const i = Math.min(Math.floor(Math.log(bytes) / Math.log(k)), sizes.length - 1);
                return parseFloat((bytes / k ** i).toFixed(decimals)) + ' ' + sizes[i];
            },
            fmtRate(v) { return v == null ? '—' : this.fmtBytes(v) + '/s'; },
        }));
    });
</script>

{{template "footer.template"}}
