{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/tabs.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/data-table.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/overflow-menu.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/search.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/link.min.js"></script>
<script defer src="/assets/js/pages/docker.js"></script>
<section class="page" x-data="dockerPage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-inline-notification low-contrast x-show="error" x-cloak kind="error" title="Docker unavailable" :subtitle="error" hide-close-button></cds-inline-notification>
    <cds-tabs x-cds-prop:value="tab" @cds-tabs-selected="tab = $event.detail.item.value"><cds-tab id="containers-tab" value="containers" target="containers-panel">Containers</cds-tab><cds-tab id="images-tab" value="images" target="images-panel">Images</cds-tab></cds-tabs>
    <section aria-label="Docker resources">
    <cds-table-toolbar size="lg"><cds-table-toolbar-content><cds-table-toolbar-search persistent label-text="Search Docker resources" placeholder="Search names, images, or IDs" x-cds-model="search"></cds-table-toolbar-search><cds-button kind="ghost" :disabled="busy" @click="read()">Refresh<span slot="icon">{{icon "renew" 16}}</span></cds-button></cds-table-toolbar-content></cds-table-toolbar>
    <section id="containers-panel" role="tabpanel" aria-labelledby="containers-tab" x-show="tab === 'containers'">
        <div class="table-scroll" role="region" aria-label="Docker containers" tabindex="0"><cds-table>
            <cds-table-head><cds-table-header-row><cds-table-header-cell>Name</cds-table-header-cell><cds-table-header-cell>Status</cds-table-header-cell><cds-table-header-cell>Image</cds-table-header-cell><cds-table-header-cell>Ports</cds-table-header-cell><cds-table-header-cell>Created</cds-table-header-cell><cds-table-header-cell>Actions</cds-table-header-cell></cds-table-header-row></cds-table-head>
            <cds-table-body><template x-for="container in filteredContainers" :key="container.Id"><cds-table-row>
                <cds-table-cell><p x-text="containerName(container)"></p><p class="muted mono" x-text="container.Id.slice(0, 12)"></p></cds-table-cell>
                <cds-table-cell><cds-tag :type="container.State === 'running' ? 'green' : container.State === 'paused' ? 'warm-gray' : 'gray'" x-text="container.State"></cds-tag></cds-table-cell><cds-table-cell class="mono" x-text="container.Image"></cds-table-cell>
                <cds-table-cell><div class="tag-list"><template x-for="(port, index) in container.Ports || []" :key="index"><cds-link :href="portURL(port)" target="_blank" rel="noopener noreferrer" x-text="(port.PublicPort ? port.PublicPort + ' → ' : '') + port.PrivatePort + '/' + port.Type"></cds-link></template><span x-show="!container.Ports?.length" class="muted">No exposed ports</span></div></cds-table-cell>
                <cds-table-cell x-text="$store.helpers.date(container.Created * 1000)"></cds-table-cell>
                <cds-table-cell><cds-overflow-menu :label="'Actions for ' + containerName(container)"><span slot="icon">{{icon "overflow-menu--vertical" 16}}</span><cds-overflow-menu-body flipped>
                    <cds-overflow-menu-item :disabled="busy || container.State === 'running' || container.State === 'paused'" @click="act('start', container)">Start</cds-overflow-menu-item>
                    <cds-overflow-menu-item :disabled="busy || !['running', 'paused'].includes(container.State)" @click="act('stop', container)">Stop</cds-overflow-menu-item>
                    <cds-overflow-menu-item :disabled="busy" @click="act('restart', container)">Restart</cds-overflow-menu-item>
                    <cds-overflow-menu-item :disabled="busy || container.State !== 'running'" @click="act('pause', container)">Pause</cds-overflow-menu-item>
                    <cds-overflow-menu-item :disabled="busy || container.State !== 'paused'" @click="act('unpause', container)">Resume</cds-overflow-menu-item>
                    <cds-overflow-menu-item danger :disabled="busy" @click="act('delete', container)">Delete</cds-overflow-menu-item>
                </cds-overflow-menu-body></cds-overflow-menu></cds-table-cell>
            </cds-table-row></template></cds-table-body>
        </cds-table></div><p class="table-empty" x-show="!filteredContainers.length">No matching containers.</p>
    </section>
    <section id="images-panel" role="tabpanel" aria-labelledby="images-tab" x-show="tab === 'images'" x-cloak>
        <div class="table-scroll" role="region" aria-label="Docker images" tabindex="0"><cds-table>
            <cds-table-head><cds-table-header-row><cds-table-header-cell>Repository / tags</cds-table-header-cell><cds-table-header-cell>Size</cds-table-header-cell><cds-table-header-cell>Created</cds-table-header-cell><cds-table-header-cell>ID</cds-table-header-cell><cds-table-header-cell>Actions</cds-table-header-cell></cds-table-header-row></cds-table-head>
            <cds-table-body><template x-for="image in filteredImages" :key="image.Id"><cds-table-row>
                <cds-table-cell><div class="tag-list"><template x-for="tag in image.RepoTags || ['Untagged']" :key="tag"><cds-tag type="gray" x-text="tag"></cds-tag></template></div></cds-table-cell><cds-table-cell x-text="$store.helpers.bytes(image.Size)"></cds-table-cell><cds-table-cell x-text="$store.helpers.date(image.Created * 1000)"></cds-table-cell><cds-table-cell class="mono" x-text="image.Id.replace('sha256:', '').slice(0, 12)"></cds-table-cell>
                <cds-table-cell><cds-overflow-menu label="Image actions"><span slot="icon">{{icon "overflow-menu--vertical" 16}}</span><cds-overflow-menu-body flipped><cds-overflow-menu-item danger :disabled="busy" @click="act('deleteImage', image)">Delete</cds-overflow-menu-item></cds-overflow-menu-body></cds-overflow-menu></cds-table-cell>
            </cds-table-row></template></cds-table-body>
        </cds-table></div><p class="table-empty" x-show="!filteredImages.length">No matching local images.</p>
    </section>
    </section>
</section>
{{template "footer.template" .}}
