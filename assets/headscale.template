{{template "header.template"}}

<div class="text-base-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h3 class="text-2xl font-bold tracking-tight flex items-center">
            <i class="ri-hub-line text-primary mr-3"></i>Headscale Control
        </h3>
        <p class="text-sm opacity-60 mt-1 ml-9">Self-hosted Tailscale control server</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" x-data="panel">

        <div class="lg:col-span-1 space-y-6">
            <div class="card surface p-6">
                <h4 class="eyebrow mb-4">Service Status</h4>

                <div class="flex items-center justify-center mb-6">
                    <div class="relative">
                        <div class="absolute -inset-4 rounded-full opacity-20 animate-ping" :class="status === 'running' ? 'bg-success' : 'hidden'"></div>

                        <div class="relative w-20 h-20 rounded-full flex items-center justify-center transition-colors duration-300"
                             :class="status === 'running' ? 'bg-success/15 text-success' : 'bg-base-200 text-base-content/40'">
                            <i class="text-4xl" :class="status === 'running' ? 'ri-shield-check-line' : 'ri-shut-down-line'"></i>
                        </div>

                        <div class="absolute bottom-0 right-0 px-2 py-0.5 text-xs font-bold rounded-full border-2 border-base-100"
                             :class="status === 'running' ? 'bg-success text-white' : 'bg-base-300 text-base-content/70'">
                            <span x-text="status === 'running' ? 'ON' : 'OFF'"></span>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    <button x-show="status !== 'running'" @click="startHeadscale" class="btn btn-success btn-block">
                        <i class="ri-play-circle-fill text-lg"></i>Start Service
                    </button>
                    <button x-show="status === 'running'" @click="stopHeadscale" class="btn btn-outline btn-error btn-block">
                        <i class="ri-stop-circle-line text-lg"></i>Stop Service
                    </button>
                    <button @click="checkStatus" class="btn btn-ghost btn-sm btn-block">
                        <i class="ri-refresh-line"></i>Refresh Status
                    </button>
                </div>
            </div>

            <div class="rounded-2xl p-5 bg-info/10 border border-info/20">
                <div class="flex items-start gap-3">
                    <i class="ri-information-fill text-info text-xl mt-0.5"></i>
                    <div>
                        <h5 class="text-sm font-bold mb-1">About Headscale</h5>
                        <p class="text-xs opacity-70 leading-relaxed">
                            Headscale is an open-source implementation of the Tailscale control server, allowing you to create your own secure mesh network.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="card surface overflow-hidden">
                <div class="row px-6 py-4 border-b border-base-300">
                    <h4 class="text-base font-semibold flex items-center"><i class="ri-settings-4-line opacity-50 mr-2"></i>Configuration</h4>
                </div>

                <div class="p-6">
                    <form id="headscaleForm" @submit.prevent="saveConfig">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                            <div class="md:col-span-2">
                                <h5 class="eyebrow border-b border-base-300 pb-2">Network</h5>
                            </div>

                            <div>
                                <span class="eyebrow block mb-1.5">Server URL</span>
                                <input name="server_url" type="url" value="https://myheadscale.example.com:443" required class="input input-bordered input-sm w-full">
                            </div>

                            <div>
                                <span class="eyebrow block mb-1.5">Base Domain</span>
                                <input name="base_domain" type="text" value="example.com" required class="input input-bordered input-sm w-full">
                            </div>

                            <div class="md:col-span-2 mt-2">
                                <h5 class="eyebrow border-b border-base-300 pb-2">Interfaces</h5>
                            </div>

                            <div>
                                <span class="eyebrow block mb-1.5">Listen Address</span>
                                <input name="listen_addr" type="text" value="0.0.0.0:8080" required class="input input-bordered input-sm w-full font-mono">
                            </div>

                            <div>
                                <span class="eyebrow block mb-1.5">Metrics Address</span>
                                <input name="metrics_listen_addr" type="text" value="127.0.0.1:9090" required class="input input-bordered input-sm w-full font-mono">
                            </div>

                            <div class="md:col-span-2 mt-2">
                                <h5 class="eyebrow border-b border-base-300 pb-2">IP Allocation</h5>
                            </div>

                            <div>
                                <span class="eyebrow block mb-1.5">IPv4 Prefix</span>
                                <input name="ipv4_prefix" type="text" value="100.64.0.0/10" required class="input input-bordered input-sm w-full font-mono">
                            </div>

                            <div>
                                <span class="eyebrow block mb-1.5">IPv6 Prefix</span>
                                <input name="ipv6_prefix" type="text" value="fd7a:115c:a1e0::/48" required class="input input-bordered input-sm w-full font-mono">
                            </div>

                            <div class="md:col-span-2 mt-2">
                                <h5 class="eyebrow border-b border-base-300 pb-2">STUN Server</h5>
                            </div>

                            <div class="md:col-span-2" x-data="{ stunEnabled: true }">
                                <input type="hidden" name="stun_enabled" :value="stunEnabled">
                                <label class="flex items-center gap-2 cursor-pointer mb-4">
                                    <input type="checkbox" x-model="stunEnabled" class="checkbox checkbox-sm checkbox-primary">
                                    <span class="text-sm font-medium">Enable STUN Server</span>
                                </label>

                                <div x-show="stunEnabled" x-transition>
                                    <span class="eyebrow block mb-1.5">STUN Listen Address</span>
                                    <input name="stun_listen_addr" type="text" value="0.0.0.0:3478" class="input input-bordered input-sm w-full font-mono">
                                    <p class="text-xs opacity-60 mt-2">
                                        DERP uses this STUN address when embedded DERP is enabled; standalone STUN starts only when DERP is disabled.
                                    </p>
                                </div>
                            </div>

                            <div class="md:col-span-2 mt-2">
                                <h5 class="eyebrow border-b border-base-300 pb-2">DERP Server</h5>
                            </div>

                            <div class="md:col-span-2" x-data="{ derpEnabled: false }">
                                <input type="hidden" name="derp_enabled" :value="derpEnabled">
                                <label class="flex items-center gap-2 cursor-pointer mb-4">
                                    <input type="checkbox" x-model="derpEnabled" class="checkbox checkbox-sm checkbox-primary">
                                    <span class="text-sm font-medium">Enable Embedded DERP Server</span>
                                </label>

                                <div x-show="derpEnabled" x-transition class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <span class="eyebrow block mb-1.5">Region ID</span>
                                        <input name="derp_region_id" type="number" value="999" class="input input-bordered input-sm w-full font-mono">
                                    </div>

                                    <div>
                                        <span class="eyebrow block mb-1.5">Region Code</span>
                                        <input name="derp_region_code" type="text" value="gopanel" class="input input-bordered input-sm w-full font-mono">
                                    </div>

                                    <div>
                                        <span class="eyebrow block mb-1.5">Region Name</span>
                                        <input name="derp_region_name" type="text" value="GoPanel Embedded DERP" class="input input-bordered input-sm w-full">
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input name="derp_verify_clients" type="checkbox" class="checkbox checkbox-sm checkbox-primary">
                                            <span class="text-sm font-medium">Verify Clients</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="md:col-span-2">
                                <span class="eyebrow block mb-1.5">Private Key Path</span>
                                <input name="private_key_path" type="text" value="/var/lib/headscale/noise_private.key" required class="input input-bordered input-sm w-full font-mono">
                            </div>
                        </div>

                        <div class="flex justify-end pt-4 border-t border-base-300">
                            <button type="submit" class="btn btn-primary">
                                <i class="ri-save-3-line text-lg"></i>Save Configuration
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('panel', () => ({
            status: 'stopped',

            async init() {
                await this.checkStatus();
                setInterval(() => this.checkStatus(), 5000); // Polling
            },

            async checkStatus() {
                try {
                    const response = await fetch('/admin/headscale?status=check', { method: 'POST' });
                    if (response.ok) {
                        const result = await response.json();
                        this.status = result.status || 'stopped';
                    }
                } catch (error) {
                    console.error('Status check failed:', error);
                }
            },

            async saveConfig(e) {
                try {
                    const formData = new FormData(e.target);
                    const response = await fetch('/admin/headscale', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();
                    if (result.success) {
                        alert('Configuration saved successfully');
                    } else {
                        alert('Save failed: ' + (result.message || 'Unknown error'));
                    }
                } catch (error) {
                    alert('Error: ' + error.message);
                }
            },

            async startHeadscale() {
                try {
                    const form = document.getElementById('headscaleForm');
                    const formData = new FormData(form);

                    // Optimistic UI update
                    const prevStatus = this.status;
                    this.status = 'running';

                    const response = await fetch('/admin/headscale?status=start', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();

                    if (result.success) {
                        alert('Headscale service started');
                    } else {
                        this.status = prevStatus; // Revert on fail
                        alert('Start failed: ' + result.message);
                    }
                } catch (error) {
                    this.status = 'stopped';
                    alert('Error: ' + error.message);
                }
            },

            async stopHeadscale() {
                if (!confirm('Are you sure you want to stop the Headscale service?')) return;

                try {
                    const response = await fetch('/admin/headscale?status=stop', {
                        method: 'POST'
                    });
                    const result = await response.json();
                    if (result.success) {
                        this.status = 'stopped';
                    } else {
                        alert('Stop failed: ' + result.message);
                    }
                } catch (error) {
                    alert('Error: ' + error.message);
                }
            }
        }))
    })
</script>
{{template "footer.template"}}
