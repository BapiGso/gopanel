{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/text-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/number-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/toggle.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/checkbox.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tile.min.js"></script>
<script defer src="/assets/js/pages/headscale.js"></script>
<section class="page" x-data="headscalePage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-inline-notification low-contrast kind="warning" title="Experimental feature" subtitle="This is a limited embedded Headscale configuration, not the full upstream YAML schema. Running does not guarantee startup readiness." hide-close-button></cds-inline-notification>
    <cds-inline-notification low-contrast x-show="status.last_error" x-cloak kind="error" title="Service error" :subtitle="status.last_error" hide-close-button></cds-inline-notification>
    <div class="toolbar">
        <cds-button size="md" kind="ghost" :disabled="busy || !loaded || status.state === 'running'" @click="start()">Save and start</cds-button>
        <cds-button size="md" kind="ghost" :disabled="busy || !status.stop_supported" @click="stop()">Stop</cds-button>
        <cds-button size="md" kind="ghost" :disabled="busy" @click="readStatus()">Refresh status<span slot="icon">{{icon "renew" 16}}</span></cds-button>
    </div>
    <p x-show="!status.stop_supported" class="muted">The upstream library cannot safely stop a running embedded Headscale instance. Restart the panel instead.</p>
    <cds-tile>
        <form class="stack" @submit.prevent="save()">
            <h2>Configuration</h2>
            <div class="form-grid">
                <cds-text-input label="Server URL" required x-cds-model="settings.server_url"></cds-text-input>
                <cds-text-input label="Base domain" required x-cds-model="settings.base_domain"></cds-text-input>
                <cds-text-input label="Listen address" required x-cds-model="settings.listen_addr"></cds-text-input>
                <cds-text-input label="Metrics address" x-cds-model="settings.metrics_listen_addr"></cds-text-input>
                <cds-text-input label="IPv4 prefix" required x-cds-model="settings.ipv4_prefix"></cds-text-input>
                <cds-text-input label="IPv6 prefix" required x-cds-model="settings.ipv6_prefix"></cds-text-input>
                <cds-text-input label="Private key path" required x-cds-model="settings.private_key_path"></cds-text-input>
            </div>
            <h3>STUN and DERP</h3>
            <div class="form-grid">
                <cds-toggle label-text="Standalone STUN" label-a="Off" label-b="On" x-cds-model="settings.stun_enabled"></cds-toggle>
                <cds-toggle label-text="Embedded DERP" label-a="Off" label-b="On" x-cds-model="settings.derp_enabled"></cds-toggle>
                <cds-text-input label="STUN listen address" x-cds-model="settings.stun_listen_addr"></cds-text-input>
                <cds-number-input label="DERP region ID" min="1" step="1" x-cds-model.number="settings.derp_region_id"></cds-number-input>
                <cds-text-input label="DERP region code" x-cds-model="settings.derp_region_code"></cds-text-input>
                <cds-text-input label="DERP region name" x-cds-model="settings.derp_region_name"></cds-text-input>
                <cds-checkbox x-cds-model="settings.derp_verify_clients">Verify DERP clients</cds-checkbox>
            </div>
            <p class="muted">DERP uses the STUN listen address when enabled. Standalone STUN starts only when DERP is disabled. Saving does not restart an already running service.</p>
            <div class="form-actions"><cds-button :disabled="busy || !loaded" @click.prevent="save()">Save configuration<span slot="icon">{{icon "save" 16}}</span></cds-button></div>
        </form>
    </cds-tile>
</section>
{{template "footer.template" .}}
