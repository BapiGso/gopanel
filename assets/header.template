<!DOCTYPE html>
<html lang="{{.Language}}">
{{template "document-head.template" .}}
<body x-data="shellPage">
    <cds-header aria-label="GoPanel" class="dds-theme-zone-g100">
        <cds-header-menu-button button-label-active="Close navigation" button-label-inactive="Open navigation"
                                x-cds-prop:active="navOpen" @cds-header-menu-button-toggled="navOpen = $event.detail.active"></cds-header-menu-button>
        <cds-header-name href="/admin/monitor" prefix="">GoPanel</cds-header-name>
        <div class="header-actions">
            <cds-header-global-action button-label-active="Change color theme" button-label-inactive="Change color theme"
                                      @click="$store.theme.toggle()">
                <span slot="icon" x-show="$store.theme.current === 'g100'">{{icon "sun" 20}}</span>
                <span slot="icon" x-show="$store.theme.current !== 'g100'">{{icon "moon" 20}}</span>
            </cds-header-global-action>
        </div>
    </cds-header>
    <cds-side-nav aria-label="Administration" class="dds-theme-zone-g100" collapse-mode="responsive" x-cds-prop:expanded="wide || navOpen"
                  @click="if ($event.composedPath().some(element => element.classList?.contains('cds--side-nav__overlay'))) navOpen = false"
                  @focusout="if (!wide &amp;&amp; !$el.contains($event.relatedTarget)) navOpen = false">
        <cds-side-nav-items @click="navOpen = false">
            <div class="nav-heading cds--type-heading-compact-01">Administration</div>
            <cds-side-nav-divider></cds-side-nav-divider>
            <cds-side-nav-link href="/admin/monitor" x-cds-prop:active="location.pathname === '/admin/monitor'">Monitor</cds-side-nav-link>
            <cds-side-nav-divider></cds-side-nav-divider>
            <cds-side-nav-link href="/admin/website" x-cds-prop:active="location.pathname === '/admin/website'">Website</cds-side-nav-link>
            <cds-side-nav-link href="/admin/file" x-cds-prop:active="location.pathname === '/admin/file'">Files</cds-side-nav-link>
            <cds-side-nav-link href="/admin/webdav" x-cds-prop:active="location.pathname === '/admin/webdav'">WebDAV</cds-side-nav-link>
            <cds-side-nav-divider></cds-side-nav-divider>
            <cds-side-nav-link href="/admin/term" x-cds-prop:active="location.pathname === '/admin/term'">Terminal</cds-side-nav-link>
            <cds-side-nav-link href="/admin/cron" x-cds-prop:active="location.pathname === '/admin/cron'">Cron</cds-side-nav-link>
            <cds-side-nav-link href="/admin/docker" x-cds-prop:active="location.pathname === '/admin/docker'">Docker</cds-side-nav-link>
            <cds-side-nav-divider></cds-side-nav-divider>
            <cds-side-nav-link href="/admin/frp" x-cds-prop:active="location.pathname === '/admin/frp'">FRP</cds-side-nav-link>
            <cds-side-nav-link href="/admin/headscale" x-cds-prop:active="location.pathname === '/admin/headscale'">Headscale</cds-side-nav-link>
            <cds-side-nav-link href="/admin/firewall" x-cds-prop:active="location.pathname === '/admin/firewall'">Firewall</cds-side-nav-link>
            <cds-side-nav-divider></cds-side-nav-divider>
            <cds-side-nav-link href="/admin/security" x-cds-prop:active="location.pathname === '/admin/security'">Security</cds-side-nav-link>
        </cds-side-nav-items>
    </cds-side-nav>
    <main id="main-content" class="app-content cds--grid">
        <div class="cds--row"><div class="cds--col-sm-4 cds--col-md-8 cds--col-lg-16">
