{{template "header.template"}}

<div class="text-base-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h3 class="text-2xl font-bold tracking-tight flex items-center">
            <i class="ri-hard-drive-2-line text-primary mr-3"></i>WebDAV Manager
        </h3>
        <p class="text-sm opacity-60 mt-1 ml-9">Access your files remotely via WebDAV protocol</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
            <div class="card surface overflow-hidden">
                <div class="row px-6 py-4 border-b border-base-300">
                    <h4 class="text-base font-semibold flex items-center"><i class="ri-settings-4-line mr-2 opacity-50"></i>Service Configuration</h4>
                </div>

                <form action="/admin/webdav" method="post" @submit.prevent="saveConfig" class="p-6">
                    <label class="row p-4 bg-base-200/50 rounded-xl border border-base-300 mb-6 cursor-pointer">
                        <span>
                            <span class="text-sm font-medium block">Enable WebDAV</span>
                            <span class="text-xs opacity-60">Turn the service on or off</span>
                        </span>
                        <input type="checkbox" name="enable" {{if (call .getPanelConfig "webdav.enable")}}checked{{end}} class="toggle toggle-success">
                    </label>

                    <div class="space-y-5">
                        <div>
                            <span class="text-sm font-medium block mb-1.5">Username</span>
                            <label class="input input-bordered flex items-center gap-2">
                                <i class="ri-user-3-line opacity-50"></i>
                                <input type="text" name="username" value="{{call .getPanelConfig "webdav.username"}}" required class="grow">
                            </label>
                        </div>
                        <div>
                            <span class="text-sm font-medium block mb-1.5">Password</span>
                            <label class="input input-bordered flex items-center gap-2">
                                <i class="ri-lock-password-line opacity-50"></i>
                                <input type="password" name="password" value="{{call .getPanelConfig "webdav.password"}}" required class="grow">
                            </label>
                        </div>
                    </div>

                    <div class="mt-8 flex justify-end">
                        <button type="submit" class="btn btn-primary"><i class="ri-save-3-line text-lg"></i>Save Configuration</button>
                    </div>
                </form>
            </div>

            <div class="rounded-2xl p-5 bg-info/10 border border-info/20">
                <div class="flex items-start gap-3 mb-3">
                    <i class="ri-windows-fill text-info text-xl mt-0.5"></i>
                    <div>
                        <h5 class="text-sm font-bold">Windows Explorer Native Support</h5>
                        <p class="text-sm opacity-70 mt-1 leading-relaxed">
                            Windows only supports HTTPS WebDAV by default. To allow HTTP connections, you must modify the registry.
                        </p>
                    </div>
                </div>
                <div class="bg-[#1e1e1e] rounded-lg p-3 border border-white/10 shadow-inner">
                    <code class="font-mono text-xs text-success block overflow-x-auto whitespace-pre-wrap select-all">reg add "HKLM\SYSTEM\CurrentControlSet\Services\WebClient\Parameters" /v BasicAuthLevel /t REG_DWORD /d 2 /f
                        Restart-Service -Name "WebClient"</code>
                </div>
            </div>
        </div>

        <div class="lg:col-span-1 space-y-6">
            <div class="surface rounded-2xl p-6">
                <h5 class="eyebrow mb-3">Server Address</h5>
                <div class="bg-base-200 rounded-xl border border-base-300 p-3 font-mono text-sm break-all" x-text="`${location.origin}/webdav`"></div>
                <p class="text-xs opacity-60 mt-2">Use this URL to connect your WebDAV clients.</p>
            </div>

            <div class="card surface overflow-hidden">
                <div class="px-6 py-4 border-b border-base-300">
                    <h4 class="text-base font-semibold">Connection Guide</h4>
                </div>
                <div class="divide-y divide-base-300">
                    <div class="p-4 flex items-start gap-3 hover:bg-base-200/50 transition-colors">
                        <div class="p-2 bg-base-200 rounded-lg"><i class="ri-windows-line text-info"></i></div>
                        <div>
                            <p class="text-sm font-medium">Windows</p>
                            <p class="text-xs opacity-60">This PC > Map network drive</p>
                        </div>
                    </div>
                    <div class="p-4 flex items-start gap-3 hover:bg-base-200/50 transition-colors">
                        <div class="p-2 bg-base-200 rounded-lg"><i class="ri-apple-line"></i></div>
                        <div>
                            <p class="text-sm font-medium">macOS</p>
                            <p class="text-xs opacity-60">Finder > Go > Connect to Server</p>
                        </div>
                    </div>
                    <div class="p-4 flex items-start gap-3 hover:bg-base-200/50 transition-colors">
                        <div class="p-2 bg-base-200 rounded-lg"><i class="ri-ubuntu-line text-warning"></i></div>
                        <div>
                            <p class="text-sm font-medium">Linux</p>
                            <p class="text-xs opacity-60">File Manager > Other Locations</p>
                        </div>
                    </div>
                    <div class="p-4 flex items-start gap-3 hover:bg-base-200/50 transition-colors">
                        <div class="p-2 bg-base-200 rounded-lg"><i class="ri-smartphone-line text-primary"></i></div>
                        <div>
                            <p class="text-sm font-medium">Mobile</p>
                            <p class="text-xs opacity-60">Use Apps like Documents/FE File Explorer</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('panel', () => ({
            async saveConfig(e) {
                try {
                    // Add loading state visual feedback if desired
                    const btn = e.target.querySelector('button[type="submit"]');
                    const originalContent = btn.innerHTML;
                    btn.innerHTML = '<i class="ri-loader-4-line animate-spin mr-2"></i> Saving...';
                    btn.disabled = true;

                    const response = await fetch(e.target.action, {
                        method: 'POST',
                        body: new FormData(e.target)
                    });

                    if (response.ok) {
                        // Small visual success indicator before reload
                        btn.innerHTML = '<i class="ri-check-line mr-2"></i> Saved';
                        btn.classList.remove('btn-primary');
                        btn.classList.add('btn-success');

                        setTimeout(() => {
                            alert('Configuration saved successfully');
                            location.reload();
                        }, 500);
                    } else {
                        alert('Failed to save configuration');
                        btn.innerHTML = originalContent;
                        btn.disabled = false;
                    }
                } catch (error) {
                    alert('Error: ' + error.message);
                    const btn = e.target.querySelector('button[type="submit"]');
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                }
            }
        }))
    })
</script>
{{template "footer.template"}}