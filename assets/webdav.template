{{template "header.template" .}}
<section class="page" x-data="webdavPage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <div class="cds--row">
        <div class="cds--col-sm-4 cds--col-md-8 cds--col-lg-10">
            <cds-tile class="stack"><h2>Service configuration</h2>
                <form class="stack" @submit.prevent="save" @keydown.enter.prevent="save">
                    <cds-toggle label-text="Enable WebDAV" label-a="On" label-b="Off" x-cds-model="enabled"></cds-toggle>
                    <div class="form-grid">
                        <cds-text-input label="Username" required x-cds-model="username"></cds-text-input>
                        <cds-password-input label="New password" helper-text="Leave blank to keep the current password." autocomplete="new-password" x-cds-model="password"></cds-password-input>
                    </div>
                    <div class="form-actions"><cds-button type="submit" :disabled="busy" @click.prevent="save">Save configuration<span slot="icon">{{icon "save" 16}}</span></cds-button></div>
                </form>
                <cds-inline-loading x-show="busy" x-cloak assistive-text="Saving configuration">Saving configuration</cds-inline-loading>
            </cds-tile>
        </div>
        <div class="cds--col-sm-4 cds--col-md-8 cds--col-lg-6 stack">
            <cds-tile class="stack"><h2>Server address</h2><cds-code-snippet type="single" x-text="address"></cds-code-snippet><p class="muted">Use this URL in your WebDAV client.</p></cds-tile>
            <cds-tile class="stack"><h2>Connection guide</h2><p>Windows: This PC → Map network drive.</p><p>macOS: Finder → Go → Connect to Server.</p><p>Linux: File Manager → Other Locations.</p><p>Mobile: use Documents or FE File Explorer.</p></cds-tile>
        </div>
    </div>
    <cds-inline-notification low-contrast kind="info" title="Windows Explorer" subtitle="Windows supports HTTPS WebDAV by default. Prefer HTTPS. HTTP Basic authentication exposes credentials without TLS." hide-close-button></cds-inline-notification>
    <cds-code-snippet type="multi">reg add "HKLM\SYSTEM\CurrentControlSet\Services\WebClient\Parameters" /v BasicAuthLevel /t REG_DWORD /d 2 /f
Restart-Service -Name "WebClient"</cds-code-snippet>
</section>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tile.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/toggle.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/text-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/password-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/code-snippet.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/inline-loading.min.js"></script>
<script defer src="/assets/js/pages/webdav.js"></script>
{{template "footer.template" .}}
