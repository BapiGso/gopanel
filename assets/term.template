{{template "header.template" .}}
<script type="module" src="/assets/vendor/carbon/v2.67.0/tabs.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/text-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/password-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/number-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/checkbox.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tag.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/tile.min.js"></script>
<link rel="stylesheet" href="/assets/css/xterm.css">
<script defer src="/assets/js/xterm.js"></script>
<script defer src="/assets/js/xterm-addon-attach.js"></script>
<script defer src="/assets/js/xterm-addon-fit.js"></script>
<script defer src="/assets/js/xterm-addon-web-links.js"></script>
<script defer src="/assets/js/pages/term.js"></script>
<section class="page" x-data="termPage" data-page="{{.Page}}">
    {{template "page-header.template" .}}
    <cds-tile><form class="stack" @submit.prevent="connect()">
        <div class="form-grid">
            <cds-text-input label="Host" autocomplete="off" required x-cds-model="form.host"></cds-text-input>
            <cds-number-input label="Port" min="1" max="65535" step="1" x-cds-model.number="form.port"></cds-number-input>
            <cds-text-input label="Username" autocomplete="off" required x-cds-model="form.username"></cds-text-input>
            <cds-password-input label="Password" autocomplete="new-password" helper-text="Optional when the server has a matching SSH private key. Never stored." x-cds-model="form.password"></cds-password-input>
        </div>
        <cds-checkbox x-cds-model="remember">Remember host, port, and username only</cds-checkbox>
        <div class="form-actions"><cds-button kind="ghost" x-show="hasSaved" @click.prevent="forget()">Forget saved connection</cds-button><cds-button :disabled="connecting" @click.prevent="connect()" x-text="connecting ? 'Connecting…' : 'Connect'"></cds-button></div>
    </form></cds-tile>
    <cds-tabs x-show="sessions.length" x-cds-prop:value="active" @cds-tabs-selected="activate($event.detail.item.value)">
        <template x-for="session in sessions" :key="session.id"><cds-tab :id="'terminal-tab-' + session.id" :value="session.id" :target="'terminal-panel-' + session.id" x-text="session.label"></cds-tab></template>
    </cds-tabs>
    <template x-for="session in sessions" :key="session.id"><section :id="'terminal-panel-' + session.id" role="tabpanel" :aria-labelledby="'terminal-tab-' + session.id" x-show="active === session.id" class="terminal-frame">
        <div class="toolbar"><cds-tag :type="session.state === 'connected' ? 'green' : session.state === 'connecting' ? 'blue' : 'gray'" x-text="session.state"></cds-tag><span class="mono" x-text="session.label"></span><cds-button kind="danger--ghost" @click="closeSession(session.id)">Close session<span slot="icon">{{icon "close" 16}}</span></cds-button></div>
        <div class="terminal" :data-session="session.id" aria-label="Interactive SSH terminal"></div>
        <div class="terminal-keys" aria-label="Touch keyboard helpers">
            <cds-button kind="ghost" size="sm" @click="sendKey(session.id, '\u001b')">Esc</cds-button><cds-button kind="ghost" size="sm" @click="sendKey(session.id, '\t')">Tab</cds-button>
            <cds-button :kind="session.controlPending ? 'tertiary' : 'ghost'" size="sm" :aria-pressed="session.controlPending" @click="toggleControl(session)">Ctrl</cds-button><cds-button kind="ghost" size="sm" @click="sendKey(session.id, '\u0003')">Ctrl+C</cds-button>
            <cds-button kind="ghost" size="sm" aria-label="Arrow left" @click="sendKey(session.id, '\u001b[D')">←</cds-button><cds-button kind="ghost" size="sm" aria-label="Arrow up" @click="sendKey(session.id, '\u001b[A')">↑</cds-button><cds-button kind="ghost" size="sm" aria-label="Arrow down" @click="sendKey(session.id, '\u001b[B')">↓</cds-button><cds-button kind="ghost" size="sm" aria-label="Arrow right" @click="sendKey(session.id, '\u001b[C')">→</cds-button>
        </div>
    </section></template>
    <p class="table-empty" x-show="!sessions.length">Connect to a host to open a terminal. Leaving this page closes its sessions.</p>
</section>
{{template "footer.template" .}}
