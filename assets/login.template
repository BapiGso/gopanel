{{template "public-header.template" .}}
<section class="page login-layout" x-data="loginPage" data-page="{{.Page}}">
    <div class="login-form">
        <p class="login-product cds--type-heading-compact-02">GoPanel</p>
        <h1 class="cds--type-heading-05">登录 GoPanel</h1>
        <p class="cds--type-body-01 muted">使用面板账户，安全地管理服务器。</p>
        <cds-inline-notification low-contrast x-show="error" x-cloak kind="error" title="登录失败" :subtitle="error" hide-close-button></cds-inline-notification>
        <form method="post" action="" class="stack" @submit.prevent="submit" @keydown.enter.prevent="submit">
            <cds-text-input size="lg" label="用户名" name="username" autocomplete="username" required x-cds-model="username"></cds-text-input>
            <cds-password-input size="lg" label="密码" name="password" autocomplete="current-password" required x-cds-model="password"></cds-password-input>
            <cds-inline-loading x-show="busy" x-cloak assistive-text="正在登录">正在登录</cds-inline-loading>
            <cds-button size="lg" type="submit" :disabled="busy" @click.prevent="submit">登录<span slot="icon">{{icon "arrow--right" 16}}</span></cds-button>
        </form>
    </div>
    <aside class="login-brand"><p class="cds--type-heading-06">GoPanel</p><p class="cds--type-body-01 muted">安全地管理服务器、服务与节点。</p></aside>
</section>
<script type="module" src="/assets/vendor/carbon/v2.67.0/text-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/password-input.min.js"></script>
<script type="module" src="/assets/vendor/carbon/v2.67.0/inline-loading.min.js"></script>
<script defer src="/assets/js/pages/login.js"></script>
{{template "footer.template" .}}
